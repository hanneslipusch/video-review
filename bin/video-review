// voiceover.ts
import { mkdir, rename, writeFile } from "fs/promises";
import { createHash } from "crypto";
import { homedir } from "os";
import { dirname, join } from "path";
var tts = { model: "gemini-3.8-flash-tts", voice: "Kore" };
var style = "Speak like a colleague walking someone through a short demo: warm, clear and natural.";
function cachedSpeech(text) {
  const hash = createHash("sha256").update(JSON.stringify([tts.model, tts.voice, style, text])).digest("hex");
  return join(process.env.XDG_CACHE_HOME || join(homedir(), ".cache"), "video-review", "speech", `${hash}.wav`);
}
async function speak(text, key) {
  const cached = cachedSpeech(text);
  if (await Bun.file(cached).exists())
    return cached;
  const response = await fetch("https://generativelanguage.googleapis.com/v1beta/interactions", {
    method: "POST",
    headers: { "x-goog-api-key": key, "Content-Type": "application/json" },
    signal: AbortSignal.timeout(120000),
    body: JSON.stringify({
      model: tts.model,
      input: [{ type: "user_input", content: [{
        type: "text",
        text,
        annotations: [{ type: "speech_metadata", style }]
      }] }],
      response_format: { type: "audio", mime_type: "audio/wav" },
      generation_config: { speech_config: [{ voice: tts.voice }] }
    })
  });
  if (!response.ok) {
    const reason = /"message":\s*"([^"]+)"/.exec(await response.text())?.[1]?.trim().replace(/\.$/, "");
    throw new Error(`Gemini TTS returned HTTP ${response.status}${reason ? `: ${reason}` : ""}. Check GEMINI_API_KEY, model access and quota in Google AI Studio.`);
  }
  const result = await response.json();
  if (!result || typeof result !== "object" || !("steps" in result) || !Array.isArray(result.steps))
    throw new Error("Gemini TTS returned no output steps.");
  let audio;
  for (const step of result.steps) {
    if (!step || typeof step !== "object" || step.type !== "model_output" || !Array.isArray(step.content))
      continue;
    for (const block of step.content) {
      if (block && typeof block === "object" && block.type === "audio" && typeof block.data === "string")
        audio = block.data;
    }
  }
  if (!audio || !/^[A-Za-z0-9+/]+={0,2}$/.test(audio))
    throw new Error("Gemini TTS returned no valid base64 audio.");
  const wav = Buffer.from(audio, "base64");
  if (wav.toString("ascii", 0, 4) !== "RIFF" || wav.toString("ascii", 8, 12) !== "WAVE")
    throw new Error("Gemini TTS returned audio without the documented WAV header.");
  await mkdir(dirname(cached), { recursive: true });
  await writeFile(`${cached}.${process.pid}`, wav);
  await rename(`${cached}.${process.pid}`, cached);
  return cached;
}

// cli.ts
import { parseArgs } from "util";

// rate.ts
var PLAYBACK_RATE = 1.5;

// contract.ts
var CHAPTER_LIMIT = 20;
var FPS = 30;
var READING_CHARACTERS_PER_SECOND = 17;
var SHORTEST_LINE_SECONDS = 5 / 6;
var SPEECH_TAIL_SECONDS = 0.5;
var isImage = (path) => /\.(png|jpe?g)$/i.test(path);
function parseReview(value, duration) {
  if (!value || typeof value !== "object" || !("title" in value) || !("steps" in value))
    throw new Error("Expected {title, steps: [{start, end, chapter, text, source?}]}. See video-review build --help.");
  if (typeof value.title !== "string" || !value.title.trim() || value.title.length > 160)
    throw new Error("title must contain 1\u2013160 characters.");
  if (!Array.isArray(value.steps) || !value.steps.length)
    throw new Error("steps must be a nonempty array.");
  let previousEnd = 0;
  const steps = value.steps.map((step, index) => {
    if (!step || typeof step !== "object" || !("chapter" in step) || !("text" in step))
      throw new Error(`Step ${index + 1} needs chapter and text.`);
    const { chapter, text } = step;
    const source = "source" in step ? step.source : undefined;
    if (source !== undefined && (typeof source !== "string" || !source.trim() || /[\u0000-\u001f]/.test(source)))
      throw new Error(`Step ${index + 1}: source must be a nonempty local file path.`);
    const image = source !== undefined && isImage(source);
    if (image && (("start" in step) || ("end" in step)))
      throw new Error(`Step ${index + 1}: an image step takes no start or end; it shows for as long as its line needs.`);
    if (!image && (!("start" in step) || !("end" in step)))
      throw new Error(`Step ${index + 1} needs start and end.`);
    const start = image ? 0 : ("start" in step) ? step.start : undefined;
    const end = image ? 1 : ("end" in step) ? step.end : undefined;
    if (typeof start !== "number" || typeof end !== "number" || !Number.isFinite(start) || !Number.isFinite(end) || start < (source === undefined ? previousEnd : 0) || end <= start || end >= 86400 || source === undefined && end > duration)
      throw new Error(source === undefined ? `Step ${index + 1}: intervals must be ordered, nonoverlapping, and inside 0\u2013${duration.toFixed(3)} seconds.` : `Step ${index + 1}: intervals need finite 0 <= start < end < 86400; end must fit the source.`);
    checkLine(text, index);
    if (typeof chapter !== "string" || !chapter.trim() || chapter.length > CHAPTER_LIMIT || /[\r\n\u0000-\u001f]|-->/.test(chapter))
      throw new Error(`Step ${index + 1}: chapter must be one line of 1\u2013${CHAPTER_LIMIT} characters without VTT delimiters.`);
    if (source === undefined)
      previousEnd = end;
    return { start, end, chapter: chapter.trim(), text: text.trim(), ...source === undefined ? {} : { source } };
  });
  return { title: value.title.trim(), steps };
}
function checkLine(text, index) {
  if (typeof text !== "string" || !text.trim() || text.length > 320 || /[\r\n\u0000-\u001f]|-->/.test(text))
    throw new Error(`Step ${index + 1}: text must be one line of 1\u2013320 characters without VTT delimiters.`);
}
function parseLines(value) {
  if (!value || typeof value !== "object" || !("steps" in value) || !Array.isArray(value.steps) || !value.steps.length)
    throw new Error("Expected {steps: [{text}]}. See video-review build --help.");
  return value.steps.map((step, index) => {
    const text = step && typeof step === "object" && "text" in step ? step.text : undefined;
    checkLine(text, index);
    return text.trim();
  });
}
var lineSeconds = (text, speechSeconds) => Math.ceil((speechSeconds > 0 ? speechSeconds + SPEECH_TAIL_SECONDS : Math.max(SHORTEST_LINE_SECONDS, text.length / READING_CHARACTERS_PER_SECOND) * PLAYBACK_RATE) * FPS - 0.000000001) / FPS;
function pace(steps, speech) {
  let at = 0;
  const short = [];
  const chapters = steps.map((step, index) => {
    const speechSeconds = speech[index];
    if (speechSeconds === undefined || !Number.isFinite(speechSeconds) || speechSeconds < 0)
      throw new Error(`Missing speech duration for step ${index + 1}.`);
    const needed = lineSeconds(step.text, speechSeconds);
    const footage = step.source !== undefined && isImage(step.source) ? needed : Math.round((step.end - step.start) * FPS) / FPS;
    if (footage < needed - 0.000001)
      short.push(`Step ${index + 1}: its line needs ${needed.toFixed(1)} s; its footage is ${footage.toFixed(1)} s.`);
    const chapter = { ...step, at, until: at + footage, speechSeconds };
    at = chapter.until;
    return chapter;
  });
  if (short.length)
    throw new Error(`${short.join(`
`)}
Widen each interval to footage that still shows the step, or shorten its line.`);
  return chapters;
}
function vttTime(seconds) {
  const milliseconds = Math.round(seconds * 1000);
  const parts = [Math.floor(milliseconds / 3600000), Math.floor(milliseconds / 60000) % 60, Math.floor(milliseconds / 1000) % 60];
  return parts.map((value) => String(value).padStart(2, "0")).join(":") + "." + String(milliseconds % 1000).padStart(3, "0");
}
function vtt(cues) {
  return `WEBVTT

${cues.map(({ start, end, text, id }) => `${id === undefined ? "" : `${id}
`}${vttTime(start)} --> ${vttTime(end)}
${text}
`).join(`
`)}`;
}
function chaptersVtt(chapters) {
  const edge = (seconds) => Math.ceil(seconds * 1000 - 0.000001) / 1000;
  return vtt(chapters.map((s, i) => ({ id: i + 1, start: edge(s.at), end: edge(s.until), text: s.chapter })));
}
var renderPlayer = (template, title) => template.replace(/\{\{TITLE\}\}/g, () => Bun.escapeHTML(title));

// cli.ts
var FRAME_STEP = 0.5;
var PREVIEW_RATE = 2.5;
var WIDTH = 1920;
var HEIGHT = 1080;
var help = `video-review \u2014 turn an existing recording into a captioned review

  video-review build <video> <steps.json> --out <directory>
  video-review build --help
  video-review frames <video> --out <directory>
  video-review lines <steps.json> [--captions-only]

Example:
  video-review frames recording.webm --out frames
  video-review build recording.webm steps.json --out review

frames writes one image every ${FRAME_STEP} s of the recording, named by its second (0003.5.jpg),
and sheet-1.jpg, sheet-2.jpg\u2026 with 12 labelled frames each, to find the steps at a glance.
Sheets are too small for text: open the full frame at each step's end before writing its caption.
lines prints the seconds each step's line needs, so a recording made for the review can wait that long on each step.

The recorder, verification, hosting and sharing belong to your workflow.`;
var buildHelp = `${help}

Input: {"title":"Saved settings","steps":[{"start":0,"end":3,"chapter":"Saved value","text":"The saved value appeared."}]}
chapter is a short label of 1\u2013${CHAPTER_LIMIT} characters; text is the caption and the spoken line.
Optional source names another video or a PNG/JPG card, relative to steps.json. Steps without it use <video>
and stay ordered; other videos use their own clock and may repeat or reorder. An image step has no start or end:
{"source":"what-changed.png","chapter":"What changed","text":"Watch the attachment when the model switches."}
Every source fits a ${WIDTH}\xD7${HEIGHT} frame, with bars where its shape differs.
Seconds refer to the source media clock. Each interval plays at original speed, captioned and spoken
for its whole length, and must last as long as its line needs: the build names each step that is too short.
An image step shows for as long as its line needs.

--out <directory>  Required; replaces a review built here before, refuses any other folder.
--captions-only    Build without speech, when the user asks for a silent review.
--help             Show the input contract and example before recording.

With GEMINI_API_KEY set, the build speaks each line with Gemini TTS into video.mp4; without it, the review is captions-only.
Speech is cached in $XDG_CACHE_HOME/video-review/speech (default ~/.cache), so a rebuild requests only changed lines.
Outputs: index.html, video.mp4, preview.gif (captioned, at 2.5\xD7, for pages that cannot play video), poster.jpg,
captions.vtt, chapters.vtt, thumbnails.vtt, thumbnails.jpg, timeline.json, and frames/*.jpg: per step, its first,
middle and last frame with the caption as shown.
Source audio is removed. Inputs are never changed.
Success prints one JSON object listing the frames. Read each; if one does not show what its caption says, fix steps.json and build again.
Exit 0: built, 1: runtime failure, 2: usage.`;
function speechKey(captionsOnly) {
  if (captionsOnly)
    return;
  const key = process.env.GEMINI_API_KEY;
  if (!key)
    process.stderr.write(`No GEMINI_API_KEY, so captions only. Deliver this review, and tell the user to set the key from https://aistudio.google.com/apikey and build again for a voiceover.
`);
  return key || undefined;
}
function requireFFmpeg() {
  for (const tool of ["ffmpeg", "ffprobe"])
    if (!Bun.which(tool))
      throw new Error(`${tool} not found on PATH. Install FFmpeg: https://ffmpeg.org/download.html`);
}
async function run(command, cwd = ".") {
  const child = Bun.spawn(command, { cwd, stdout: "pipe", stderr: "pipe" });
  const [stdout, stderr, code] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited]);
  if (code !== 0)
    throw new Error(`${command[0]} failed (${code}): ${stderr.trim()}`);
  return stdout;
}
async function probe(path, video = false) {
  const data = JSON.parse(await run(["ffprobe", "-v", "error", ...video ? ["-select_streams", "v:0", "-show_entries", "stream=width,height:format=duration"] : ["-show_entries", "format=duration"], "-of", "json", path]));
  const { width = 0, height = 0 } = data.streams?.[0] ?? {};
  if (video && !width)
    throw new Error("Input contains no video stream.");
  const seconds = Number(data.format?.duration);
  if (!Number.isFinite(seconds) || seconds <= 0 || seconds >= 86400)
    throw new Error(`Cannot read a positive media duration below 24 hours: ${basename(path)}`);
  return { seconds, width, height };
}
async function sha256(path) {
  const hasher = createHash2("sha256");
  for await (const chunk of createReadStream(path))
    hasher.update(chunk);
  return hasher.digest("hex");
}
async function build(video, input, destination, key) {
  requireFFmpeg();
  const source = await realpath(video);
  const target = resolve(destination);
  const main = await probe(source, true);
  const review = parseReview(JSON.parse(await readFile(input, "utf8")), main.seconds);
  const media = new Map;
  for (const [index, step] of review.steps.entries()) {
    const path = step.source === undefined ? source : await realpath(resolve(dirname2(resolve(input)), step.source));
    let entry = media.get(path);
    if (!entry) {
      const image = isImage(path);
      if (image) {
        const data = JSON.parse(await run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=codec_name,width,height", "-of", "json", path]));
        const stream = data.streams?.[0];
        if (!stream?.width || !["png", "mjpeg"].includes(stream.codec_name))
          throw new Error(`Invalid PNG/JPG image: ${basename(path)}`);
      }
      entry = { image, seconds: image ? Infinity : (path === source ? main : await probe(path, true)).seconds, sha256: await sha256(path), steps: [] };
      media.set(path, entry);
    }
    if (step.end > entry.seconds)
      throw new Error(`Step ${index + 1}: end exceeds ${basename(path)} duration.`);
    entry.steps.push(index);
  }
  await run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i", "color=s=2x2:d=0.04", "-c:v", "libx264", "-f", "null", "-"]);
  const existing = await readdir(target).catch(() => null);
  if (existing?.length && !existing.includes("timeline.json"))
    throw new Error(`${target} exists and is not a video-review output. Choose another --out directory.`);
  const output = `${target}.partial-${process.pid}`;
  await mkdir2(dirname2(target), { recursive: true });
  await mkdir2(output);
  try {
    await mkdir2(join2(output, "frames"));
    const speech = [], lengths = [];
    for (const [index, step] of review.steps.entries()) {
      if (!key) {
        lengths.push(0);
        continue;
      }
      process.stderr.write(`Voiceover ${index + 1}/${review.steps.length}
`);
      speech.push(await speak(step.text, key));
      lengths.push((await probe(speech[index])).seconds);
    }
    const voiceover = key !== undefined;
    const timeline = pace(review.steps, lengths);
    const total = timeline.at(-1).until;
    const args = ["ffmpeg", "-v", "error"];
    for (const [path, { image }] of media)
      args.push(...image ? ["-loop", "1", "-framerate", String(FPS)] : [], "-reinit_filter:v", "0", "-i", path);
    for (const path of speech)
      args.push("-i", path);
    const filters = [];
    for (const [inputIndex, { steps }] of [...media.values()].entries())
      filters.push(`[${inputIndex}:v]split=${steps.length}${steps.map((i) => `[source${i}]`).join("")}`);
    for (const [index, step] of timeline.entries()) {
      const length = step.until - step.at;
      filters.push(`[source${index}]trim=start=${step.start}:end=${step.start + length},setpts=PTS-STARTPTS,fps=${FPS},scale=trunc(iw*sar/2)*2:ih,scale=${WIDTH}:${HEIGHT}:force_original_aspect_ratio=decrease,pad=${WIDTH}:${HEIGHT}:(ow-iw)/2:(oh-ih)/2,setsar=1,tpad=stop_mode=clone:stop_duration=0.1,trim=duration=${length},setpts=PTS-STARTPTS[v${index}]`);
      if (voiceover)
        filters.push(`[${media.size + index}:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=mono,apad,atrim=duration=${length},asetpts=PTS-STARTPTS[a${index}]`);
    }
    filters.push(`${timeline.map((_, i) => `[v${i}]${voiceover ? `[a${i}]` : ""}`).join("")}concat=n=${timeline.length}:v=1:a=${voiceover ? 1 : 0}[v]${voiceover ? "[a]" : ""}`);
    await run([...args, "-filter_complex_threads", "2", "-filter_complex", filters.join(";"), "-map", "[v]", ...voiceover ? ["-map", "[a]"] : ["-an"], "-c:v", "libx264", "-threads", "2", "-preset", "fast", "-crf", "24", "-pix_fmt", "yuv420p", ...voiceover ? ["-c:a", "aac", "-b:a", "96k"] : [], "-movflags", "+faststart", join2(output, "video.mp4")]);
    const rendered = (await probe(join2(output, "video.mp4"), true)).seconds;
    if (Math.abs(rendered - total) > 0.1)
      throw new Error(`Rendered duration ${rendered.toFixed(3)}s differs from the planned ${total.toFixed(3)}s. The recording may change frame properties midstream.`);
    await writeFile2(join2(output, "captions.vtt"), vtt(timeline.map((s, i) => ({ id: i + 1, start: s.at, end: s.until, text: s.text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;") }))));
    await writeFile2(join2(output, "chapters.vtt"), chaptersVtt(timeline));
    const captioned = "subtitles=captions.vtt";
    await run(["ffmpeg", "-v", "error", "-i", "video.mp4", "-vf", `${captioned},setpts=PTS/${PREVIEW_RATE},fps=10,scale='min(960,iw)':-2:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle`, "preview.gif"], output);
    for (let first = 0;first < timeline.length; first += 33) {
      const picks = timeline.slice(first, first + 33).flatMap((s) => [s.at + 0.1, (s.at + s.until) / 2, s.until - 1 / FPS].map((t) => `eq(n,${Math.round(t * FPS)})`));
      await run([
        "ffmpeg",
        "-v",
        "error",
        "-i",
        "video.mp4",
        "-vf",
        `${captioned},select='${picks.join("+")}',scale='min(960,iw)':-2,tile=3x1:padding=8:color=white`,
        "-fps_mode",
        "vfr",
        "-pix_fmt",
        "yuvj420p",
        "-q:v",
        "3",
        "-start_number",
        String(first + 1),
        join2("frames", "%d.jpg")
      ], output);
    }
    for (const [index] of timeline.entries())
      if (!(await stat(join2(output, "frames", `${index + 1}.jpg`)).catch(() => null))?.size)
        throw new Error(`Frames for step ${index + 1} are missing.`);
    await run(["ffmpeg", "-v", "error", "-ss", String(timeline[0].until - 0.1), "-i", "video.mp4", "-frames:v", "1", "-pix_fmt", "yuvj420p", "-q:v", "2", "poster.jpg"], output);
    const count = Math.ceil(total / 2), columns = Math.min(10, count), rows = Math.ceil(count / columns);
    const tileHeight = 2 * Math.round(160 * HEIGHT / WIDTH);
    await run([
      "ffmpeg",
      "-v",
      "error",
      "-i",
      "video.mp4",
      "-vf",
      `fps=1/2:start_time=0:round=up,scale=320:${tileHeight},tile=${columns}x${rows}`,
      "-frames:v",
      "1",
      "-pix_fmt",
      "yuvj420p",
      "-threads",
      "1",
      "-q:v",
      "2",
      "thumbnails.jpg"
    ], output);
    if (!(await stat(join2(output, "thumbnails.jpg"))).size)
      throw new Error("Thumbnail sprite is empty.");
    await writeFile2(join2(output, "thumbnails.vtt"), vtt(Array.from({ length: count }, (_, i) => ({
      start: i * 2,
      end: Math.min(total, (i + 1) * 2),
      text: `thumbnails.jpg#xywh=${i % columns * 320},${Math.floor(i / columns) * tileHeight},320,${tileHeight}`
    }))));
    const manifest = {
      title: review.title,
      sources: [...media].map(([path, { sha256 }]) => ({ file: basename(path), sha256 })),
      voiceover: voiceover ? tts : null,
      steps: timeline.map(({ start, end, ...step }) => step.source !== undefined && isImage(step.source) ? step : { start, end, ...step })
    };
    await writeFile2(join2(output, "timeline.json"), JSON.stringify(manifest, null, 2) + `
`);
    await mkdir2(join2(output, "vendor"));
    for (const [name, content] of Object.entries(assets))
      await writeFile2(join2(output, "vendor", name), Buffer.from(content, "base64"));
    await writeFile2(join2(output, "index.html"), renderPlayer(template, review.title));
    await rm(target, { recursive: true, force: true });
    await rename2(output, target);
    console.log(JSON.stringify({ player: join2(target, "index.html"), video: join2(target, "video.mp4"), preview: join2(target, "preview.gif"), frames: timeline.map((_, i) => join2(target, "frames", `${i + 1}.jpg`)) }));
  } catch (error) {
    await rm(output, { recursive: true, force: true });
    throw error;
  }
}
async function lines(input, key) {
  const seconds = [];
  for (const text of parseLines(JSON.parse(await readFile(input, "utf8"))))
    seconds.push(lineSeconds(text, key ? (await probe(await speak(text, key))).seconds : 0));
  console.log(JSON.stringify({ seconds: seconds.map((s) => Math.ceil(s * 10) / 10) }));
}
async function frames(video, destination) {
  requireFFmpeg();
  const output = resolve(destination);
  const { seconds } = await probe(await realpath(video), true);
  await mkdir2(output, { recursive: true });
  const sample = `fps=${1 / FRAME_STEP}:start_time=0,trim=end_frame=${Math.floor(seconds / FRAME_STEP) + 1}`;
  await run(["ffmpeg", "-v", "error", "-y", "-reinit_filter:v", "0", "-i", video, "-vf", sample, "-pix_fmt", "yuvj420p", "-q:v", "3", join2(output, "frame-%d.jpg")]);
  await run([
    "ffmpeg",
    "-v",
    "error",
    "-y",
    "-reinit_filter:v",
    "0",
    "-i",
    video,
    "-vf",
    `${sample},scale=480:-2,` + "pad=iw:ih+22:0:0:white,drawtext=text='%{pts\\:hms}':fontsize=18:x=4:y=h-20:fontcolor=black,tile=3x4:padding=4:color=white",
    "-pix_fmt",
    "yuvj420p",
    "-q:v",
    "3",
    join2(output, "sheet-%d.jpg")
  ]);
  const files = await readdir(output);
  const written = files.filter((name) => /^frame-\d+\.jpg$/.test(name));
  for (const name of written) {
    const at = (Number(name.slice(6, -4)) - 1) * FRAME_STEP;
    await rename2(join2(output, name), join2(output, `${at.toFixed(1).padStart(6, "0")}.jpg`));
  }
  const sheets = files.filter((name) => /^sheet-\d+\.jpg$/.test(name)).sort((a, b) => Number(a.slice(6, -4)) - Number(b.slice(6, -4)));
  console.log(JSON.stringify({ frames: output, count: written.length, every: FRAME_STEP, seconds, sheets: sheets.map((name) => join2(output, name)) }));
}
try {
  const { values, positionals } = parseArgs({ args: process.argv.slice(2), options: { out: { type: "string" }, help: { type: "boolean" }, "captions-only": { type: "boolean" } }, allowPositionals: true, strict: true });
  const [command, video, input, ...extra] = positionals;
  if (values.help || !command) {
    console.log(command === "build" ? buildHelp : help);
  } else if (command === "build" && video && input && values.out && !extra.length) {
    await build(video, input, values.out, speechKey(values["captions-only"] === true));
  } else if (command === "lines" && video && !input && !values.out) {
    const key = speechKey(values["captions-only"] === true);
    if (key)
      requireFFmpeg();
    await lines(video, key);
  } else if (command === "frames" && video && !input && values.out && !values["captions-only"]) {
    await frames(video, values.out);
  } else {
    console.error(help);
    process.exitCode = 2;
  }
} catch (error) {
  let message = error instanceof Error ? error.message : "Build failed.";
  const key = process.env.GEMINI_API_KEY;
  if (key)
    message = message.replaceAll(key, "[redacted]");
  console.error(`video-review: ${message}`);
  process.exitCode = error instanceof Error && "code" in error && String(error.code).startsWith("ERR_PARSE_ARGS") ? 2 : 1;
}
