var style = "Speak like a colleague walking someone through a short demo: warm, clear and natural.";
function fetchOnce(url, init) {
  return fetch(url, { ...init, redirect: "error", signal: AbortSignal.timeout(120000) });
}
fetchOnce.preconnect = fetch.preconnect;
function providers() {
  const env = process.env, list = [];
  if (env.GEMINI_API_KEY) {
    const voice = { provider: "gemini", model: "gemini-3.8-flash-tts", voice: "Kore" };
    const model = createGoogle({ apiKey: env.GEMINI_API_KEY, fetch: fetchOnce }).speech(voice.model);
    list.push(sdk(voice, model, { instructions: style, outputFormat: "wav" }));
  }
  if (env.AZURE_API_KEY) {
    const resource = env.AZURE_RESOURCE_NAME ?? "";
    if (/^[a-z0-9-]+$/i.test(resource))
      list.push(azure(env.AZURE_API_KEY, resource));
    else
      process.stderr.write(`AZURE_API_KEY needs AZURE_RESOURCE_NAME, the name of its Azure AI Services resource, so Azure is skipped.
`);
  }
  if (env.ELEVENLABS_API_KEY) {
    if (env.ELEVENLABS_VOICE_ID) {
      const voice = { provider: "elevenlabs", model: "eleven_v4", voice: encodeURIComponent(env.ELEVENLABS_VOICE_ID) };
      const model = createElevenLabs({ apiKey: env.ELEVENLABS_API_KEY, fetch: fetchOnce }).speech(voice.model);
      list.push(sdk(voice, model, { outputFormat: "wav_24000" }));
    } else
      process.stderr.write(`ELEVENLABS_API_KEY needs ELEVENLABS_VOICE_ID, a voice your account can use, so ElevenLabs is skipped.
`);
  }
  return list;
}
function redact(message) {
  for (const key of [process.env.GEMINI_API_KEY, process.env.AZURE_API_KEY, process.env.ELEVENLABS_API_KEY])
    if (key)
      message = message.replaceAll(key, "[redacted]");
  return message;
}
var speechDir = () => join(process.env.XDG_CACHE_HOME || join(homedir(), ".cache"), "video-review", "speech");
function cachedSpeech({ provider, model, voice }, text) {
  const hash = createHash("sha256").update(JSON.stringify([provider, model, voice, style, text])).digest("hex");
  return join(speechDir(), `${hash}.wav`);
}
async function speakAll(voices, texts, measure) {
  const order = (await Promise.all(voices.map(async (provider) => ({
    provider,
    cached: (await Promise.all(texts.map((text) => Bun.file(cachedSpeech(provider, text)).exists()))).filter(Boolean).length
  })))).sort((a, b) => b.cached - a.cached);
  await mkdir(speechDir(), { recursive: true });
  const failures = [];
  for (const [index, { provider }] of order.entries()) {
    try {
      const paths = [], seconds = [];
      for (const [line, text] of texts.entries()) {
        process.stderr.write(`Voiceover ${line + 1}/${texts.length} (${provider.provider})
`);
        const path = await speak(provider, text);
        seconds.push(await measure(path).catch(async (error) => {
          await rm(path, { force: true });
          throw error;
        }));
        paths.push(path);
      }
      const { synthesize: _, ...voice } = provider;
      return { voice, paths, seconds };
    } catch (error) {
      failures.push(`${provider.provider}: ${reason(error)}`);
      const next = order[index + 1]?.provider;
      if (next)
        process.stderr.write(`${failures.at(-1)}. Speaking every line with ${next.provider} instead; the voiceover stays whole, nothing to fix.
`);
    }
  }
  throw new Error(`${failures.join(". ")}. Build with --captions-only, deliver it, and tell the user what to fix for a voiceover.`);
}
async function speak(provider, text) {
  const cached = cachedSpeech(provider, text);
  if (await Bun.file(cached).exists())
    return cached;
  const audio = await provider.synthesize(text);
  await writeFile(`${cached}.${process.pid}`, audio);
  await rename(`${cached}.${process.pid}`, cached);
  return cached;
}
function reason(error) {
  let message = error instanceof Error ? error.message : String(error);
  if (APICallError.isInstance(error)) {
    let body = error.responseBody ?? "";
    try {
      body = JSON.stringify(JSON.parse(body));
    } catch {}
    message = [error.statusCode && `HTTP ${error.statusCode}`, message, body].filter(Boolean).join(" ");
  }
  return redact(message).replace(/\s+/g, " ").trim().slice(0, 500).replace(/\.$/, "");
}
function sdk(voice, model, options) {
  return { ...voice, synthesize: async (text) => (await generateSpeech({ model, text, voice: voice.voice, maxRetries: 0, ...options })).audio.uint8Array };
}
function azure(key, resource) {
  const voice = "en-US-AvaMultilingualNeural";
  return { provider: "azure", model: "neural", voice, async synthesize(text) {
    const response = await fetchOnce(`https://${resource}.cognitiveservices.azure.com/tts/cognitiveservices/v1`, {
      method: "POST",
      headers: { "Ocp-Apim-Subscription-Key": key, "Content-Type": "application/ssml+xml", "X-Microsoft-OutputFormat": "riff-24khz-16bit-mono-pcm", "User-Agent": "video-review" },
      body: `<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="en-US"><voice name="${voice}">${Bun.escapeHTML(text)}</voice></speak>`
    });
    if (!response.ok)
      throw new APICallError({ message: response.statusText, url: response.url, requestBodyValues: {}, statusCode: response.status, responseBody: await response.text() });
    return response.bytes();
  } };
}

// cli.ts
import { parseArgs } from "util";

// playback.ts
var PLAYBACK_RATE = 1.5;
var FPS = 30;

// contract.ts
var CHAPTER_LIMIT = 20;
var READING_CHARACTERS_PER_SECOND = 17;
var SHORTEST_LINE_SECONDS = 5 / 6;
var SPEECH_TAIL_SECONDS = 0.5;
var isImage = (path) => /\.(png|jpe?g)$/i.test(path);
function parseReview(value, duration) {
  if (!value || typeof value !== "object" || !("title" in value) || !("steps" in value))
    throw new Error("Expected {title, steps: [{start, end, chapter, text, source?, notes?}]}. See video-review build --help.");
  if (typeof value.title !== "string" || !value.title.trim() || value.title.length > 160)
    throw new Error("title must contain 1\u2013160 characters.");
  if (!Array.isArray(value.steps) || !value.steps.length)
    throw new Error("steps must be a nonempty array.");
  let previousEnd = 0;
  const steps = value.steps.map((step, index) => {
    if (!step || typeof step !== "object" || !("chapter" in step) || !("text" in step))
      throw new Error(`Step ${index + 1} needs chapter and text.`);
    const { chapter, text } = step;
    const source = localPath(step, "source", index), notes = localPath(step, "notes", index);
    const image = source !== undefined && isImage(source);
    if (image && (("start" in step) || ("end" in step)))
      throw new Error(`Step ${index + 1}: an image step takes no start or end; it shows for as long as its line needs.`);
    if (!image && (!("start" in step) || !("end" in step)))
      throw new Error(`Step ${index + 1} needs start and end.`);
    const start = image ? 0 : ("start" in step) ? step.start : undefined;
    const end = image ? 1 : ("end" in step) ? step.end : undefined;
    if (typeof start !== "number" || typeof end !== "number" || !Number.isFinite(start) || !Number.isFinite(end) || start < (source === undefined ? previousEnd : 0) || end <= start || end >= 86400 || source === undefined && end > duration)
      throw new Error(source === undefined ? `Step ${index + 1}: intervals must be ordered, nonoverlapping, and inside 0\u2013${duration.toFixed(3)} seconds.` : `Step ${index + 1}: intervals need finite 0 <= start < end < 86400; end must fit the source.`);
    checkLine(text, index);
    if (typeof chapter !== "string" || !chapter.trim() || chapter.length > CHAPTER_LIMIT || /[\r\n\u0000-\u001f]|-->/.test(chapter))
      throw new Error(`Step ${index + 1}: chapter must be one line of 1\u2013${CHAPTER_LIMIT} characters without VTT delimiters.`);
    if (source === undefined)
      previousEnd = end;
    return { start, end, chapter: chapter.trim(), text: text.trim(), ...source === undefined ? {} : { source }, ...notes === undefined ? {} : { notes } };
  });
  return { title: value.title.trim(), steps };
}
function localPath(step, name, index) {
  const path = name in step ? Reflect.get(step, name) : undefined;
  if (path !== undefined && (typeof path !== "string" || !path.trim() || /[\u0000-\u001f]/.test(path)))
    throw new Error(`Step ${index + 1}: ${name} must be a nonempty local file path.`);
  return path;
}
function checkLine(text, index) {
  if (typeof text !== "string" || !text.trim() || text.length > 320 || /[\r\n\u0000-\u001f]|-->/.test(text))
    throw new Error(`Step ${index + 1}: text must be one line of 1\u2013320 characters without VTT delimiters.`);
}
function parseLines(value) {
  if (!value || typeof value !== "object" || !("steps" in value) || !Array.isArray(value.steps) || !value.steps.length)
    throw new Error("Expected {steps: [{text}]}. See video-review build --help.");
  return value.steps.map((step, index) => {
    const text = step && typeof step === "object" && "text" in step ? step.text : undefined;
    checkLine(text, index);
    return text.trim();
  });
}
var lineSeconds = (text, speechSeconds) => Math.ceil((speechSeconds > 0 ? speechSeconds + SPEECH_TAIL_SECONDS : Math.max(SHORTEST_LINE_SECONDS, text.length / READING_CHARACTERS_PER_SECOND) * PLAYBACK_RATE) * FPS - 0.000000001) / FPS;
function pace(steps, speech) {
  let at = 0;
  const short = [];
  const chapters = steps.map((step, index) => {
    const speechSeconds = speech[index];
    const needed = lineSeconds(step.text, speechSeconds);
    const footage = step.source !== undefined && isImage(step.source) ? needed : Math.round((step.end - step.start) * FPS) / FPS;
    if (footage < needed - 0.000001)
      short.push(`Step ${index + 1}: its line needs ${needed.toFixed(1)} s; its footage is ${footage.toFixed(1)} s.`);
    const chapter = { ...step, at, until: at + footage, speechSeconds };
    at = chapter.until;
    return chapter;
  });
  if (short.length)
    throw new Error(`${short.join(`
`)}
Widen each interval to footage that still shows the step, or shorten its line.`);
  return chapters;
}
function vttTime(seconds) {
  const milliseconds = Math.round(seconds * 1000);
  const parts = [Math.floor(milliseconds / 3600000), Math.floor(milliseconds / 60000) % 60, Math.floor(milliseconds / 1000) % 60];
  return parts.map((value) => String(value).padStart(2, "0")).join(":") + "." + String(milliseconds % 1000).padStart(3, "0");
}
function vtt(cues, settings = "") {
  return `WEBVTT

${cues.map(({ start, end, text, id }) => `${id === undefined ? "" : `${id}
`}${vttTime(start)} --> ${vttTime(end)}${settings && ` ${settings}`}
${text}
`).join(`
`)}`;
}
function chaptersVtt(chapters) {
  const edge = (seconds) => Math.ceil(seconds * 1000 - 0.000001) / 1000;
  return vtt(chapters.map((s, i) => ({ id: i + 1, start: edge(s.at), end: edge(s.until), text: s.chapter })));
}
var notePage = (chapter, markdown, background) => `<!doctype html><meta charset="utf-8"><style>
body{margin:0;padding:24px;font:24px/1.45 system-ui,sans-serif;color:#20302a;background:${background}}
article{padding:20px 22px;border:2px solid #e1e5e0;border-radius:16px;background:#fff}
h2{margin:0 0 16px;font-size:20px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:#5c6a60}
p,ul,ol,pre,table{margin:0 0 18px}article>:last-child{margin-bottom:0}ul,ol{padding-left:30px}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{padding:8px 12px 8px 0;border-bottom:2px solid #e9ece8;text-align:left;vertical-align:top}th{font-weight:600}
code{font:20px/1.45 ui-monospace,monospace;overflow-wrap:anywhere}pre{padding:10px 12px;border-radius:10px;background:#f3f5f2;white-space:pre-wrap}
</style><article><h2>${Bun.escapeHTML(chapter)}</h2>${Bun.markdown.html(markdown, { noHtmlBlocks: true, noHtmlSpans: true, autolinks: true })}</article>`;
function renderPlayer(template, title, width, height) {
  const divisor = (a, b) => b ? divisor(b, a % b) : a;
  const values = {
    TITLE: Bun.escapeHTML(title),
    ASPECT: `${width / divisor(width, height)}/${height / divisor(width, height)}`,
    PAGE: String(Math.round(48 + 1072 * 9 / 16 * width / height))
  };
  return template.replace(/\{\{(TITLE|ASPECT|PAGE)\}\}/g, (_, key) => values[key]);
}

// cli.ts
var FRAME_STEP = 0.5;
var PREVIEW_RATE = 2.5;
var WIDTH = 1920;
var HEIGHT = 1080;
var NOTE_WIDTH = 640;
var NOTE_BACKGROUND = "#f7f8f6";
var help = `video-review \u2014 turn an existing recording into a captioned review

  video-review build <video> <steps.json> --out <directory>
  video-review build --help
  video-review frames <video> --out <directory>
  video-review lines <steps.json> [--captions-only]

Example:
  video-review frames recording.webm --out frames
  video-review build recording.webm steps.json --out review

frames writes one image every ${FRAME_STEP} s of the recording, named by its second (0003.5.jpg),
and sheet-1.jpg, sheet-2.jpg\u2026 with 12 labelled frames each, to find the steps at a glance.
Sheets are too small for text: open the full frame at each step's end before writing its caption.
lines prints the seconds each step's line needs, so a recording made for the review can wait that long on each step.

The recorder, verification, hosting and sharing belong to your workflow.`;
var buildHelp = `${help}

Input: {"title":"Saved settings","steps":[{"start":0,"end":3,"chapter":"Saved value","text":"The saved value appeared."}]}
chapter is a short label of 1\u2013${CHAPTER_LIMIT} characters; text is the caption and the spoken line.
Optional source names another video or a PNG/JPG card, relative to steps.json. Steps without it use <video>
and stay ordered; other videos use their own clock and may repeat or reorder. An image step has no start or end:
{"source":"what-changed.png","chapter":"What changed","text":"Watch the attachment when the model switches."}
Optional notes names a Markdown file, relative to steps.json, drawn in a ${NOTE_WIDTH} px panel right of the footage while
its step plays, for what the footage cannot show, such as query counts or logs. It needs Chrome, Chromium, Edge or
Brave outside macOS, must fit ${HEIGHT} px tall, and shows as plain text in timeline.json.
Every source fits a ${WIDTH}\xD7${HEIGHT} frame, with bars where its shape differs.
Seconds refer to the source media clock. Each interval plays at original speed, captioned and spoken
for its whole length, and must last as long as its line needs: the build names each step that is too short.
An image step shows for as long as its line needs.

--out <directory>  Required; replaces a review built here before, refuses any other folder.
--captions-only    Build without speech, when the user asks for a silent review.
--help             Show the input contract and example before recording.

The build speaks each line into video.mp4 with one provider, in this order of the ones set: GEMINI_API_KEY,
AZURE_API_KEY with AZURE_RESOURCE_NAME, ELEVENLABS_API_KEY with ELEVENLABS_VOICE_ID; one that already spoke most
lines goes first. If one fails, the next speaks every line. Without any, the review is captions-only.
Speech is cached in $XDG_CACHE_HOME/video-review/speech (default ~/.cache), so a rebuild requests only changed lines.
Outputs: index.html, video.mp4, preview.gif (captioned, at 2.5\xD7, for pages that cannot play video), poster.jpg,
captions.vtt, chapters.vtt, thumbnails.vtt, thumbnails.jpg, timeline.json, and frames/*.jpg: per step, its first,
middle and last frame with the caption as shown.
Source audio is removed. Inputs are never changed.
Success prints one JSON object listing the frames. Read each; if one does not show what its caption says, fix steps.json and build again.
Exit 0: built, 1: runtime failure, 2: usage.`;
function voiceProviders(captionsOnly) {
  if (captionsOnly)
    return [];
  const list = providers();
  if (!list.length)
    process.stderr.write(`No speech key, so captions only. Deliver this review, and tell the user to set GEMINI_API_KEY from https://aistudio.google.com/apikey, or another provider from video-review build --help, and build again for a voiceover.
`);
  return list;
}
function requireFFmpeg() {
  for (const tool of ["ffmpeg", "ffprobe"])
    if (!Bun.which(tool))
      throw new Error(`${tool} not found on PATH. Install FFmpeg: https://ffmpeg.org/download.html`);
}
async function run(command, cwd = ".") {
  const child = Bun.spawn(command, { cwd, stdout: "pipe", stderr: "pipe" });
  const [stdout, stderr, code] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited]);
  if (code !== 0)
    throw new Error(`${command[0]} failed (${code}): ${stderr.trim()}`);
  return stdout;
}
async function probe(path, video = false) {
  const data = JSON.parse(await run(["ffprobe", "-v", "error", ...video ? ["-select_streams", "v:0", "-show_entries", "stream=width,height:format=duration"] : ["-show_entries", "format=duration"], "-of", "json", path]));
  const { width = 0, height = 0 } = data.streams?.[0] ?? {};
  if (video && !width)
    throw new Error("Input contains no video stream.");
  const seconds = Number(data.format?.duration);
  if (!Number.isFinite(seconds) || seconds <= 0 || seconds >= 86400)
    throw new Error(`Cannot read a positive media duration below 24 hours: ${basename2(path)}`);
  return { seconds, width, height };
}
var speechSeconds = async (path) => (await probe(path)).seconds;
async function sha256(path) {
  const hasher = createHash2("sha256");
  for await (const chunk of createReadStream(path))
    hasher.update(chunk);
  return hasher.digest("hex");
}
async function build(video, input, destination, voices) {
  requireFFmpeg();
  const source = await realpath(video);
  const target = resolve2(destination);
  const main = await probe(source, true);
  const review = parseReview(JSON.parse(await readFile(input, "utf8")), main.seconds);
  const media = new Map;
  for (const [index, step] of review.steps.entries()) {
    const path = step.source === undefined ? source : await realpath(resolve2(dirname(resolve2(input)), step.source));
    let entry = media.get(path);
    if (!entry) {
      const image = isImage(path);
      if (image) {
        const data = JSON.parse(await run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=codec_name,width,height", "-of", "json", path]));
        const stream = data.streams?.[0];
        if (!stream?.width || !["png", "mjpeg"].includes(stream.codec_name))
          throw new Error(`Invalid PNG/JPG image: ${basename2(path)}`);
      }
      entry = { image, seconds: image ? Infinity : (path === source ? main : await probe(path, true)).seconds, sha256: await sha256(path), steps: [] };
      media.set(path, entry);
    }
    if (step.end > entry.seconds)
      throw new Error(`Step ${index + 1}: end exceeds ${basename2(path)} duration.`);
    entry.steps.push(index);
  }
  for (const [index, step] of review.steps.entries()) {
    if (step.notes === undefined)
      continue;
    const path = resolve2(dirname(resolve2(input)), step.notes);
    step.notes = (await readFile(path, "utf8").catch(() => {
      throw new Error(`Step ${index + 1}: cannot read notes ${path}.`);
    })).trim();
    if (!step.notes)
      throw new Error(`Step ${index + 1}: notes ${path} is empty.`);
  }
  await run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i", "color=s=2x2:d=0.04", "-c:v", "libx264", "-f", "null", "-"]);
  const existing = await readdir(target).catch(() => null);
  if (existing?.length && !existing.includes("timeline.json"))
    throw new Error(`${target} exists and is not a video-review output. Choose another --out directory.`);
  const output = `${target}.partial-${process.pid}`;
  await mkdir2(dirname(target), { recursive: true });
  await mkdir2(output);
  try {
    await mkdir2(join2(output, "frames"));
    const panels = await drawNotes(review.steps, output);
    const width = panels.some(Boolean) ? WIDTH + NOTE_WIDTH : WIDTH;
    const spoken = voices.length ? await speakAll(voices, review.steps.map((step) => step.text), speechSeconds) : undefined;
    const speech = spoken?.paths ?? [];
    const lengths = spoken?.seconds ?? review.steps.map(() => 0);
    const voiceover = spoken !== undefined;
    const timeline = pace(review.steps, lengths);
    const total = timeline.at(-1).until;
    const args = ["ffmpeg", "-v", "error"];
    for (const [path, { image }] of media)
      args.push(...image ? ["-loop", "1", "-framerate", String(FPS)] : [], "-reinit_filter:v", "0", "-i", path);
    for (const path of speech)
      args.push("-i", path);
    const panelInputs = new Map;
    for (const [index, path] of panels.entries()) {
      if (!path)
        continue;
      panelInputs.set(index, media.size + speech.length + panelInputs.size);
      args.push("-loop", "1", "-framerate", String(FPS), "-i", path);
    }
    const filters = [];
    for (const [inputIndex, { steps }] of [...media.values()].entries())
      filters.push(`[${inputIndex}:v]split=${steps.length}${steps.map((i) => `[source${i}]`).join("")}`);
    for (const [index, step] of timeline.entries()) {
      const length = step.until - step.at;
      const footage = `[source${index}]trim=start=${step.start}:end=${step.start + length},setpts=PTS-STARTPTS,fps=${FPS},scale=trunc(iw*sar/2)*2:ih,scale=${WIDTH}:${HEIGHT}:force_original_aspect_ratio=decrease,pad=${WIDTH}:${HEIGHT}:(ow-iw)/2:(oh-ih)/2,setsar=1,tpad=stop_mode=clone:stop_duration=0.1,trim=duration=${length},setpts=PTS-STARTPTS`;
      const panel = panelInputs.get(index);
      if (panel !== undefined)
        filters.push(`${footage}[f${index}]`, `[${panel}:v]scale=${NOTE_WIDTH}:${HEIGHT},setsar=1,format=yuv420p,trim=duration=${length},setpts=PTS-STARTPTS[n${index}]`, `[f${index}][n${index}]hstack[v${index}]`);
      else
        filters.push(`${footage}${width > WIDTH ? `,pad=${width}:${HEIGHT}:0:0:${NOTE_BACKGROUND}` : ""}[v${index}]`);
      if (voiceover)
        filters.push(`[${media.size + index}:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=mono,apad,atrim=duration=${length},asetpts=PTS-STARTPTS[a${index}]`);
    }
    filters.push(`${timeline.map((_, i) => `[v${i}]${voiceover ? `[a${i}]` : ""}`).join("")}concat=n=${timeline.length}:v=1:a=${voiceover ? 1 : 0}[v]${voiceover ? "[a]" : ""}`);
    await run([...args, "-filter_complex_threads", "2", "-filter_complex", filters.join(";"), "-map", "[v]", ...voiceover ? ["-map", "[a]"] : ["-an"], "-c:v", "libx264", "-threads", "2", "-preset", "fast", "-crf", "24", "-pix_fmt", "yuv420p", ...voiceover ? ["-c:a", "aac", "-b:a", "96k"] : [], "-movflags", "+faststart", join2(output, "video.mp4")]);
    const rendered = (await probe(join2(output, "video.mp4"), true)).seconds;
    if (Math.abs(rendered - total) > 0.1)
      throw new Error(`Rendered duration ${rendered.toFixed(3)}s differs from the planned ${total.toFixed(3)}s. The recording may change frame properties midstream.`);
    await writeFile2(join2(output, "captions.vtt"), vtt(timeline.map((s, i) => ({ id: i + 1, start: s.at, end: s.until, text: s.text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;") })), width > WIDTH ? `position:${100 * WIDTH / 2 / width}% size:${100 * WIDTH / width}%` : ""));
    await writeFile2(join2(output, "chapters.vtt"), chaptersVtt(timeline));
    const captioned = width > WIDTH ? `subtitles=captions.vtt:force_style='MarginR=${Math.round(384 * NOTE_WIDTH / width)}'` : "subtitles=captions.vtt";
    await run(["ffmpeg", "-v", "error", "-i", "video.mp4", "-vf", `${captioned},setpts=PTS/${PREVIEW_RATE},fps=10,scale=-2:'min(540,ih)':flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle`, "preview.gif"], output);
    for (let first = 0;first < timeline.length; first += 33) {
      const picks = timeline.slice(first, first + 33).flatMap((s) => [s.at + 0.1, (s.at + s.until) / 2, s.until - 1 / FPS].map((t) => `eq(n,${Math.round(t * FPS)})`));
      await run([
        "ffmpeg",
        "-v",
        "error",
        "-i",
        "video.mp4",
        "-vf",
        `${captioned},select='${picks.join("+")}',scale=-2:'min(540,ih)',tile=3x1:padding=8:color=white`,
        "-fps_mode",
        "vfr",
        "-q:v",
        "3",
        "-start_number",
        String(first + 1),
        join2("frames", "%d.jpg")
      ], output);
    }
    for (const [index] of timeline.entries())
      if (!(await stat(join2(output, "frames", `${index + 1}.jpg`)).catch(() => null))?.size)
        throw new Error(`Frames for step ${index + 1} are missing.`);
    await run(["ffmpeg", "-v", "error", "-ss", String(timeline[0].until - 0.1), "-i", "video.mp4", "-frames:v", "1", "-update", "1", "-q:v", "2", "poster.jpg"], output);
    const count = Math.ceil(total / 2), columns = Math.min(10, count), rows = Math.ceil(count / columns);
    const tileHeight = 180, tileWidth = 2 * Math.round(tileHeight / 2 * width / HEIGHT);
    await run([
      "ffmpeg",
      "-v",
      "error",
      "-i",
      "video.mp4",
      "-vf",
      `fps=1/2:start_time=0:round=up,scale=${tileWidth}:${tileHeight},tile=${columns}x${rows}`,
      "-frames:v",
      "1",
      "-update",
      "1",
      "-threads",
      "1",
      "-q:v",
      "2",
      "thumbnails.jpg"
    ], output);
    if (!(await stat(join2(output, "thumbnails.jpg"))).size)
      throw new Error("Thumbnail sprite is empty.");
    await writeFile2(join2(output, "thumbnails.vtt"), vtt(Array.from({ length: count }, (_, i) => ({
      start: i * 2,
      end: Math.min(total, (i + 1) * 2),
      text: `thumbnails.jpg#xywh=${i % columns * tileWidth},${Math.floor(i / columns) * tileHeight},${tileWidth},${tileHeight}`
    }))));
    const manifest = {
      title: review.title,
      sources: [...media].map(([path, { sha256 }]) => ({ file: basename2(path), sha256 })),
      voiceover: spoken?.voice ?? null,
      steps: timeline.map(({ start, end, ...step }) => step.source !== undefined && isImage(step.source) ? step : { start, end, ...step })
    };
    await writeFile2(join2(output, "timeline.json"), JSON.stringify(manifest, null, 2) + `
`);
    await mkdir2(join2(output, "vendor"));
    for (const [name, content] of Object.entries(assets))
      await writeFile2(join2(output, "vendor", name), Buffer.from(content, "base64"));
    await writeFile2(join2(output, "index.html"), renderPlayer(template, review.title, width, HEIGHT));
    await rm2(join2(output, "notes"), { recursive: true, force: true });
    await rm2(target, { recursive: true, force: true });
    await rename2(output, target);
    console.log(JSON.stringify({ player: join2(target, "index.html"), video: join2(target, "video.mp4"), preview: join2(target, "preview.gif"), frames: timeline.map((_, i) => join2(target, "frames", `${i + 1}.jpg`)) }));
  } catch (error) {
    await rm2(output, { recursive: true, force: true });
    throw error;
  }
}
async function drawNotes(steps, output) {
  if (steps.every((step) => step.notes === undefined))
    return [];
  await mkdir2(join2(output, "notes"));
  await using view = new Bun.WebView({ width: NOTE_WIDTH, height: HEIGHT });
  await view.navigate("about:blank");
  await view.resize(NOTE_WIDTH, HEIGHT);
  const panels = [];
  for (const [index, step] of steps.entries()) {
    if (step.notes === undefined) {
      panels.push(undefined);
      continue;
    }
    await view.navigate(`data:text/html;base64,${Buffer.from(notePage(step.chapter, step.notes, NOTE_BACKGROUND)).toString("base64")}`);
    if (await view.evaluate(`document.documentElement.scrollHeight > ${HEIGHT} || document.documentElement.scrollWidth > ${NOTE_WIDTH}`))
      throw new Error(`Step ${index + 1}: notes overflow the ${NOTE_WIDTH}\xD7${HEIGHT} px panel. Shorten them or break long lines.`);
    const path = join2(output, "notes", `${index + 1}.png`);
    await writeFile2(path, await view.screenshot({ encoding: "buffer" }));
    panels.push(path);
  }
  return panels;
}
async function lines(input, voices) {
  if (voices.length)
    requireFFmpeg();
  const texts = parseLines(JSON.parse(await readFile(input, "utf8")));
  const spoken = voices.length ? await speakAll(voices, texts, speechSeconds) : undefined;
  const seconds = texts.map((text, index) => lineSeconds(text, spoken?.seconds[index] ?? 0));
  console.log(JSON.stringify({ seconds: seconds.map((s) => Math.ceil(s * 10) / 10) }));
}
async function frames(video, destination) {
  requireFFmpeg();
  const output = resolve2(destination);
  const { seconds } = await probe(await realpath(video), true);
  await mkdir2(output, { recursive: true });
  for (const name of await readdir(output))
    if (/^(\d+\.\d|sheet-\d+)\.jpg$/.test(name))
      await rm2(join2(output, name));
  const sample = `fps=${1 / FRAME_STEP}:start_time=0,trim=end_frame=${Math.floor(seconds / FRAME_STEP) + 1},format=yuv420p`;
  await run(["ffmpeg", "-v", "error", "-y", "-reinit_filter:v", "0", "-i", video, "-vf", sample, "-q:v", "3", join2(output, "frame-%d.jpg")]);
  await run([
    "ffmpeg",
    "-v",
    "error",
    "-y",
    "-reinit_filter:v",
    "0",
    "-i",
    video,
    "-vf",
    `${sample},scale=480:-2,` + "pad=iw:ih+22:0:0:white,drawtext=text='%{pts\\:hms}':fontsize=18:x=4:y=h-20:fontcolor=black,tile=3x4:padding=4:color=white",
    "-q:v",
    "3",
    join2(output, "sheet-%d.jpg")
  ]);
  const files = await readdir(output);
  const written = files.filter((name) => /^frame-\d+\.jpg$/.test(name));
  for (const name of written) {
    const at = (Number(name.slice(6, -4)) - 1) * FRAME_STEP;
    await rename2(join2(output, name), join2(output, `${at.toFixed(1).padStart(6, "0")}.jpg`));
  }
  const sheets = files.filter((name) => /^sheet-\d+\.jpg$/.test(name)).sort((a, b) => Number(a.slice(6, -4)) - Number(b.slice(6, -4)));
  console.log(JSON.stringify({ frames: output, count: written.length, every: FRAME_STEP, seconds, sheets: sheets.map((name) => join2(output, name)) }));
}
try {
  const { values, positionals } = parseArgs({ args: process.argv.slice(2), options: { out: { type: "string" }, help: { type: "boolean" }, "captions-only": { type: "boolean" } }, allowPositionals: true, strict: true });
  const [command, video, input, ...extra] = positionals;
  if (values.help || !command) {
    console.log(command === "build" ? buildHelp : help);
  } else if (command === "build" && video && input && values.out && !extra.length) {
    await build(video, input, values.out, voiceProviders(values["captions-only"]));
  } else if (command === "lines" && video && !input && !values.out) {
    await lines(video, voiceProviders(values["captions-only"]));
  } else if (command === "frames" && video && !input && values.out && !values["captions-only"]) {
    await frames(video, values.out);
  } else {
    console.error(help);
    process.exitCode = 2;
  }
} catch (error) {
  console.error(`video-review: ${redact(error instanceof Error ? error.message : "Build failed.")}`);
  process.exitCode = error instanceof Error && "code" in error && String(error.code).startsWith("ERR_PARSE_ARGS") ? 2 : 1;
}
