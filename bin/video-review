  ])
    if (elevenLabsOptions?.[option] != null)
      warnings.push({
        type: "unsupported",
        feature: `providerOptions.elevenlabs.${option}`,
        details: `ElevenLabs streaming speech does not support ${option}.`
      });
  if (elevenLabsOptions?.dialogue != null) {
