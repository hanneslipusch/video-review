    characters: array(object({
      text: string2(),
      start: number2().nullish(),
      end: number2().nullish()
    })).nullish()
  })).nullish()
})));
function createMusicTimestampsResponseHandler() {
  return async ({ response }) => {
    const contentType = response.headers.get("content-type") ?? "";
    const boundary = contentType.match(/(?:^|;)\s*boundary=(?:"([^"]+)"|([^;\s]+))/i);
    if (!/^multipart\/mixed\b/i.test(contentType) || boundary == null)
      throw new InvalidResponseDataError({
        data: contentType,
        message: "ElevenLabs music response is missing a multipart boundary."
      });
    const bytes = new Uint8Array(await response.arrayBuffer());
    const delimiter = new TextEncoder().encode(`--${boundary[1] ?? boundary[2]}`);
    const separator = new Uint8Array([
      13,
      10,
      13,
      10
    ]);
    const decoder = new TextDecoder;
    let audio;
    let metadata;
    let position = findBoundary(bytes, delimiter, 0);
    let closed = false;
    while (position !== -1) {
      const start = position + delimiter.length;
      if (bytes[start] === 45 && bytes[start + 1] === 45) {
        closed = true;
        break;
      }
      const next = findBoundary(bytes, delimiter, start + 2);
      if (next === -1)
        break;
      const end = next - 2;
      const headersEnd = findBytes(bytes, separator, start + 2);
      if (headersEnd === -1 || headersEnd + separator.length > end)
        throw new InvalidResponseDataError({
          data: contentType,
          message: "ElevenLabs music response contains malformed part headers."
        });
      const partType = decoder.decode(bytes.subarray(start + 2, headersEnd)).match(/^content-type:\s*([^;\r\n]+)/im)?.[1].trim().toLowerCase();
      const body = bytes.subarray(headersEnd + separator.length, end);
      if (partType === "application/json") {
        if (metadata != null)
          throw new InvalidResponseDataError({
            data: contentType,
            message: "ElevenLabs music response contains multiple metadata parts."
          });
        metadata = await parseMetadata(decoder.decode(body));
      } else if (partType?.startsWith("audio/")) {
        if (audio != null)
          throw new InvalidResponseDataError({
            data: contentType,
            message: "ElevenLabs music response contains multiple audio parts."
          });
        audio = body.slice();
      }
      position = next;
    }
    if (!closed || audio == null || metadata == null)
      throw new InvalidResponseDataError({
        data: contentType,
        message: "ElevenLabs music response must contain complete metadata and audio parts."
      });
    return {
      value: {
        audio,
        ...metadata.value.words_timestamps != null && { wordTimestamps: metadata.value.words_timestamps.map((word) => ({
          word: word.word,
          startMs: word.start_ms,
          endMs: word.end_ms
        })) }
      },
      rawValue: metadata.rawValue,
      responseHeaders: extractResponseHeaders(response)
    };
  };
}
var musicMetadataSchema = lazySchema(() => zodSchema(object({ words_timestamps: array(object({
  word: string2(),
  start_ms: number2(),
  end_ms: number2()
})).nullish() })));
async function parseMetadata(text) {
  const parsed = await safeParseJSON({
    text,
    schema: musicMetadataSchema
  });
  if (!parsed.success)
    throw parsed.error;
  return parsed;
}
function findBytes(bytes, pattern, from) {
  for (let i = bytes.indexOf(pattern[0], from);i !== -1 && i <= bytes.length - pattern.length; i = bytes.indexOf(pattern[0], i + 1))
    if (pattern.every((value, index) => bytes[i + index] === value))
      return i;
  return -1;
}
function findBoundary(bytes, pattern, from) {
  for (let i = findBytes(bytes, pattern, from);i !== -1; i = findBytes(bytes, pattern, i + 1)) {
    const end = i + pattern.length;
    const lineStart = i === 0 || bytes[i - 2] === 13 && bytes[i - 1] === 10;
    const lineEnd = bytes[end] === 13 && bytes[end + 1] === 10 || bytes[end] === 45 && bytes[end + 1] === 45;
    if (lineStart && lineEnd)
      return i;
  }
  return -1;
}
function compositionPlanSchema() {
  const timeRange = object({
    start_ms: number2().int().min(0),
    end_ms: number2().int().min(0)
  });
  const audioRefChunk = object({
    song_id: string2(),
    range: timeRange
  });
  const durationMs = number2().int().min(3000).max(120000);
  const styles = array(string2());
  const musicPrompt = object({
    positive_global_styles: styles,
    negative_global_styles: styles,
    sections: array(object({
      section_name: string2().min(1).max(100),
      positive_local_styles: styles,
      negative_local_styles: styles,
      duration_ms: durationMs,
      lines: array(string2().max(200)).max(30),
      source_from: object({
        song_id: string2(),
        range: timeRange,
        negative_ranges: array(timeRange).optional()
      }).nullish()
    }))
  });
  const generationChunk = object({
    text: string2(),
    duration_ms: durationMs,
    positive_styles: styles,
    negative_styles: styles.optional(),
    context_adherence: _enum([
      "low",
      "medium",
      "high"
    ]).optional(),
    conditioning_ref: audioRefChunk.nullish(),
    condition_strength: _enum([
      "low",
      "medium",
      "high",
      "xhigh"
    ]).nullish()
  });
  const chunkedPlan = object({ chunks: array(union([generationChunk, audioRefChunk])) });
  return union([musicPrompt, chunkedPlan]);
}
