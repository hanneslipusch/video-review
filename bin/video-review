        model_id: this.modelId,
        ...elevenLabsOptions?.musicLengthMs != null && { music_length_ms: elevenLabsOptions.musicLengthMs },
        ...elevenLabsOptions?.forceInstrumental != null && { force_instrumental: elevenLabsOptions.forceInstrumental },
        ...elevenLabsOptions?.seed != null && { seed: elevenLabsOptions.seed },
