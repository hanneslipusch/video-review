function toElevenLabsStreamOutputFormat(format) {
  if (format == null)
    return defaultOutputFormat;
  const { rate } = format;
  switch (format.type.split(";")[0].trim().toLowerCase()) {
    case "audio/mpeg":
    case "audio/mp3":
      if (rate == null || rate === 44100)
        return "mp3_44100_128";
      if (rate === 22050)
        return "mp3_22050_32";
      break;
    case "audio/pcm":
    case "audio/l16": {
      const pcmRate = rate ?? 24000;
      if ([
        8000,
        16000,
        22050,
        24000,
        44100,
        48000
      ].includes(pcmRate))
        return `pcm_${pcmRate}`;
      break;
    }
    case "audio/pcmu":
    case "audio/basic":
      if (rate == null || rate === 8000)
        return "ulaw_8000";
      break;
    case "audio/pcma":
      if (rate == null || rate === 8000)
        return "alaw_8000";
      break;
    case "audio/opus":
    case "audio/ogg":
      if (rate == null || rate === 48000)
        return "opus_48000_64";
  }
  throw new InvalidArgumentError({
    argument: "outputFormat",
    message: `ElevenLabs streaming speech does not support the output format ${JSON.stringify(format)}. Use providerOptions.elevenlabs.streaming.outputFormat for a native ElevenLabs format.`
  });
}
function toElevenLabsOutputFormat(outputFormat) {
  return {
    mp3: "mp3_44100_128",
    mp3_32: "mp3_44100_32",
    mp3_64: "mp3_44100_64",
    mp3_96: "mp3_44100_96",
    mp3_128: "mp3_44100_128",
    mp3_192: "mp3_44100_192",
    pcm: "pcm_44100",
    pcm_16000: "pcm_16000",
    pcm_22050: "pcm_22050",
    pcm_24000: "pcm_24000",
    pcm_44100: "pcm_44100",
    ulaw: "ulaw_8000",
    wav: "wav_44100"
  }[outputFormat] || outputFormat;
}
function getCompositionPlanDurationMs(plan) {
  const partDurationsMs = "sections" in plan ? plan.sections.map((section) => section.duration_ms) : plan.chunks.map((chunk) => ("duration_ms" in chunk) ? chunk.duration_ms : chunk.range.end_ms - chunk.range.start_ms);
  if (partDurationsMs.length === 0 || partDurationsMs.some((durationMs) => durationMs <= 0))
    return;
  return partDurationsMs.reduce((sum, durationMs) => sum + durationMs, 0);
}
