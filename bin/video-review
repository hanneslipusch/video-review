function countCodePoints(text) {
  let count = 0;
  for (const _ of text)
    count++;
  return count;
}
var WORD_BOUNDARY = /[\s\u3002\u3001\uFF01\uFF1F\uFF0C\uFF1B\uFF1A]/u;
var MAX_HELD_CODE_POINTS = 100;
function takeCompleteWords(buffered) {
  const codePoints = Array.from(buffered);
  for (let index = codePoints.length - 1;index >= 0; index--)
    if (WORD_BOUNDARY.test(codePoints[index]))
      return {
        send: codePoints.slice(0, index + 1).join(""),
        hold: codePoints.slice(index + 1).join("")
      };
  return codePoints.length >= MAX_HELD_CODE_POINTS ? {
    send: buffered,
    hold: ""
  } : {
    send: "",
    hold: buffered
  };
}
var KEEPALIVE_INTERVAL_MS = 15000;
function getNewTurn(part) {
  const newTurn = part.providerOptions?.elevenlabs?.newTurn;
  if (newTurn != null && typeof newTurn !== "boolean")
    throw new InvalidArgumentError({
      argument: "providerOptions.elevenlabs.newTurn",
      message: "providerOptions.elevenlabs.newTurn must be a boolean."
    });
  return newTurn === true;
}
function getElevenLabsAudioFormat(outputFormat) {
  const [codec, rate] = outputFormat.split("_");
  const sampleRate = rate != null ? Number(rate) : undefined;
  const withRate = (type) => sampleRate != null && Number.isFinite(sampleRate) ? {
    type,
    rate: sampleRate
  } : { type };
  switch (codec) {
    case "mp3":
      return withRate("audio/mpeg");
    case "pcm":
      return withRate("audio/pcm");
    case "ulaw":
      return withRate("audio/pcmu");
    case "alaw":
      return withRate("audio/pcma");
    case "opus":
      return withRate("audio/ogg");
    case "wav":
      return withRate("audio/wav");
    default:
      return { type: "application/octet-stream" };
  }
}
function createSingleContextProtocol({ initMessage, voice }) {
  return {
    initMessage,
    authFields: (apiKey) => ({ "xi-api-key": apiKey }),
    keepaliveMessage: { text: " " },
    resolveVoice: (partVoice) => {
      if (partVoice != null && partVoice !== voice)
        throw new InvalidArgumentError({
          argument: "text",
          message: `The ElevenLabs text-to-speech WebSocket speaks a single voice per stream ("${voice}"); a text part requested "${partVoice}". Use an eleven_v3 or eleven_v4 model with dialogue options for several voices.`
        });
      return voice;
    },
    encodeText: (segment) => ({
      messages: [{ text: segment.text }],
      characters: countCodePoints(segment.text)
    }),
    endMessages: () => ({
      messages: [{ text: "" }],
      characters: 0
    }),
    decodeEvent: (raw) => decodeTextToSpeechEvent(raw)
  };
}
function createDialogueProtocol({ initMessage, voices, defaultVoice, incremental }) {
  const buffered = [];
  let currentVoice;
  const resolveVoice = (partVoice) => {
    const voice = partVoice ?? defaultVoice;
    if (!voices.includes(voice))
      throw new InvalidArgumentError({
        argument: "text",
        message: `Dialogue text part voice "${voice}" is not listed in providerOptions.elevenlabs.dialogue.voices.`
      });
    return voice;
  };
  const emit = (segment) => {
    const { voice } = segment;
    const newTurn = currentVoice != null && (voice !== currentVoice || segment.newTurn);
    currentVoice = voice;
    const input = {
      text: segment.text,
      voice_id: voice,
      ...newTurn && { new_turn: true }
    };
    const characters = countCodePoints(segment.text);
    if (!incremental) {
      buffered.push(input);
      return {
        messages: [],
        characters
      };
    }
    return {
      messages: [{ inputs: [input] }],
      characters
    };
  };
  return {
    initMessage: {
      ...initMessage,
      voices
    },
    authFields: (apiKey) => ({ xi_api_key: apiKey }),
    keepaliveMessage: { keep_alive: true },
    resolveVoice,
    encodeText: emit,
    endMessages: () => ({
      messages: incremental ? [{ close_socket: true }] : [{
        inputs: buffered,
        close_socket: true
      }],
      characters: 0
    }),
    decodeEvent: (raw) => {
      const error = getErrorText(raw);
      if (error != null)
        return { error };
      const alignment = camelizeAlignment(raw.alignment);
      return {
        ...typeof raw.audio === "string" && raw.audio.length > 0 && { audio: raw.audio },
        ...raw.is_final === true && { isFinal: true },
        ...(alignment != null || raw.is_final_audio_for_turn === true) && { providerMetadata: {
          ...alignment != null && { alignment },
          ...raw.is_final_audio_for_turn === true && { isFinalAudioForTurn: true }
        } }
      };
    }
  };
}
function decodeTextToSpeechEvent(raw) {
  const error = getErrorText(raw);
  if (error != null && typeof raw.audio !== "string")
    return { error };
  const alignment = raw.alignment ?? undefined;
  const normalizedAlignment = raw.normalizedAlignment ?? undefined;
  const metadata = {
    ...alignment != null && { alignment },
    ...normalizedAlignment != null && { normalizedAlignment }
  };
  return {
    ...typeof raw.audio === "string" && raw.audio.length > 0 && { audio: raw.audio },
    ...(raw.isFinal === true || raw.is_final === true) && { isFinal: true },
    ...Object.keys(metadata).length > 0 && { providerMetadata: metadata }
  };
}
function getErrorText(raw) {
  if (raw.error == null && (typeof raw.message !== "string" || raw.isFinal === true))
    return;
  if (typeof raw.message === "string")
    return raw.message;
  if (typeof raw.error === "string")
    return raw.error;
  return JSON.stringify(raw.error);
}
function camelizeAlignment(value) {
  if (value == null || typeof value !== "object")
    return;
  const alignment = value;
  return {
    ...alignment.chars != null && { chars: alignment.chars },
    ...alignment.char_start_times_ms != null && { charStartTimesMs: alignment.char_start_times_ms },
    ...alignment.char_durations_ms != null && { charDurationsMs: alignment.char_durations_ms }
  };
}
function createElevenLabsSpeechStream({ abortSignal, apiKey, audioFormat, headers, includeRawChunks, keepalive, protocol, text, url, warnings, webSocket }) {
  let finished = false;
  let cleanup = () => {};
  return new ReadableStream({
    start: (controller) => {
      let textReader;
      let connection;
      let inputCharacters = 0;
      let inputEnded = false;
      let keepaliveTimer;
      const send = (socket, message) => {
        socket.send(JSON.stringify(message));
        if (keepaliveTimer != null)
          clearTimeout(keepaliveTimer);
        if (!keepalive || inputEnded)
          return;
        keepaliveTimer = setTimeout(() => {
          if (finished || inputEnded)
            return;
          try {
            send(socket, protocol.keepaliveMessage);
          } catch (error) {
            finishWithError(error);
          }
        }, KEEPALIVE_INTERVAL_MS);
      };
      cleanup = (closeCode) => {
        if (keepaliveTimer != null)
          clearTimeout(keepaliveTimer);
        if (textReader != null)
          textReader.cancel().catch(() => {});
        else
          text.cancel().catch(() => {});
        connection?.close(closeCode);
      };
      const finishWithError = (error) => {
        if (finished)
          return;
        finished = true;
        cleanup();
        controller.error(error);
      };
      const finish = () => {
        if (finished)
          return;
        finished = true;
        controller.enqueue({
          type: "finish",
          usage: { inputCharacters }
        });
        controller.close();
        cleanup(1000);
      };
      const sendAll = async (socket, encoded) => {
        inputCharacters += encoded.characters;
        for (const message of encoded.messages) {
          send(socket, message);
          await waitForWebSocketBufferDrain(socket);
        }
      };
      const sendText = async (socket) => {
        const reader = text.getReader();
        textReader = reader;
        let held;
        const flushHeld = async () => {
          if (held != null && held.text.length > 0)
            await sendAll(socket, protocol.encodeText(held));
          held = undefined;
        };
        try {
          while (true) {
            const { done, value } = await reader.read();
            if (done || finished)
              break;
            const voice = protocol.resolveVoice(value.voice);
            const newTurn = getNewTurn(value);
            if (held != null && (held.voice !== voice || newTurn))
              await flushHeld();
            const segment = held ?? {
              text: "",
              voice,
              ...newTurn && { newTurn }
            };
            const { send: complete, hold } = takeCompleteWords(segment.text + value.text);
            if (complete.length > 0) {
              await sendAll(socket, protocol.encodeText({
                ...segment,
                text: complete
              }));
              delete segment.newTurn;
            }
            held = {
              ...segment,
              text: hold
            };
          }
        } finally {
          reader.releaseLock();
          if (textReader === reader)
            textReader = undefined;
        }
        if (!finished) {
          await flushHeld();
          inputEnded = true;
          await sendAll(socket, protocol.endMessages());
        }
      };
      connection = connectToWebSocket({
        url,
        headers,
        webSocket,
        abortSignal,
        onAbort: finishWithError,
        onOpen: (socket) => {
          controller.enqueue({
            type: "stream-start",
            warnings
          });
          send(socket, {
            ...protocol.initMessage,
            ...apiKey != null && protocol.authFields(apiKey)
          });
          sendText(socket).catch(finishWithError);
        },
        onMessageText: async (messageText) => {
          if (finished)
            return;
          const parsed = await safeParseJSON({ text: messageText });
          if (!parsed.success)
            return;
          const raw = parsed.value;
          if (includeRawChunks)
            controller.enqueue({
              type: "raw",
              rawValue: raw
            });
          const event = protocol.decodeEvent(raw);
          if (event.error != null) {
            finishWithError(/* @__PURE__ */ new Error(`ElevenLabs speech stream error: ${event.error}`));
            return;
          }
          if (event.audio != null || event.providerMetadata?.isFinalAudioForTurn === true)
            controller.enqueue({
              type: "audio",
              audio: event.audio ?? "",
              audioFormat,
              ...event.providerMetadata != null && { providerMetadata: { elevenlabs: event.providerMetadata } }
            });
          if (event.isFinal)
            finish();
        },
        onProcessingError: finishWithError,
        onSocketError: () => {
          finishWithError(/* @__PURE__ */ new Error("ElevenLabs speech stream error."));
        },
        onClose: ({ code, reason }) => {
          if (finished)
            return;
          finishWithError(/* @__PURE__ */ new Error("ElevenLabs speech stream closed before completion" + (code != null ? ` (code ${code}${reason ? `: ${reason}` : ""})` : "") + "."));
        }
      });
    },
    cancel: () => {
      if (finished)
        return;
      finished = true;
      cleanup();
    }
  });
}
var defaultVoiceId = "21m00Tcm4TlvDq8ikWAM";
var defaultOutputFormat = "mp3_44100_128";
function isDialogueModelId(modelId) {
  return modelId.startsWith("eleven_v3") || modelId.startsWith("eleven_v4");
}
function isMusicModelId(modelId) {
  return modelId.startsWith("music_");
}
function isSoundEffectsModelId(modelId) {
  return modelId.startsWith("eleven_text_to_sound");
}
var textToSpeechOnlyOptions = [
  "applyLanguageTextNormalization",
  "applyTextNormalization",
  "dialogue",
  "inputs",
  "languageCode",
  "nextRequestIds",
  "nextText",
  "previousRequestIds",
  "previousText",
  "pronunciationDictionaryLocators",
  "streaming",
  "voiceSettings"
];
var musicOnlyOptions = [
  "compositionPlan",
  "forceInstrumental",
  "musicLengthMs"
];
var soundEffectsOnlyOptions = [
  "durationSeconds",
  "loop",
  "promptInfluence"
];
var ElevenLabsSpeechModel = class ElevenLabsSpeechModel {
  get provider() {
    return this.config.provider;
  }
  static [WORKFLOW_SERIALIZE](model) {
    return serializeModelOptions({
      modelId: model.modelId,
      config: model.config
    });
  }
  static [WORKFLOW_DESERIALIZE](options) {
    return new ElevenLabsSpeechModel(options.modelId, options.config);
  }
  constructor(modelId, config) {
    this.modelId = modelId;
    this.config = config;
    this.specificationVersion = "v4";
  }
  async getArgs(options) {
    const { text, voice = "21m00Tcm4TlvDq8ikWAM", outputFormat = "mp3_44100_128", instructions, language, speed, providerOptions } = options;
    const warnings = [];
    const elevenLabsOptions = await parseProviderOptions({
      provider: "elevenlabs",
      providerOptions,
      schema: elevenLabsSpeechModelOptionsSchema
    });
    for (const option of ["streaming", "dialogue"])
      if (elevenLabsOptions?.[option] != null)
        warnings.push({
          type: "unsupported",
          feature: `providerOptions.elevenlabs.${option}`,
          details: `${option === "streaming" ? "Streaming" : "Dialogue"} options apply only to streaming speech (experimental_streamSpeech) and were ignored.`
        });
    for (const option of [...musicOnlyOptions, ...soundEffectsOnlyOptions])
      if (elevenLabsOptions?.[option] != null)
        warnings.push({
          type: "unsupported",
          feature: `providerOptions.elevenlabs.${option}`,
          details: `ElevenLabs speech models do not support ${option}; it was ignored.`
        });
    if (elevenLabsOptions?.inputs != null || this.modelId === "eleven_v4")
      return this.getDialogueArgs(options, elevenLabsOptions ?? {}, elevenLabsOptions?.inputs ?? [{
        text,
        voiceId: voice
      }], warnings);
    const requestBody = {
      text,
      model_id: this.modelId
    };
    const queryParams = {};
    if (outputFormat)
      queryParams.output_format = toElevenLabsOutputFormat(outputFormat);
    if (language)
      requestBody.language_code = language;
    const voiceSettings = {};
    if (speed != null)
      voiceSettings.speed = speed;
    if (elevenLabsOptions) {
      if (elevenLabsOptions.voiceSettings) {
        if (elevenLabsOptions.voiceSettings.stability != null)
          voiceSettings.stability = elevenLabsOptions.voiceSettings.stability;
        if (elevenLabsOptions.voiceSettings.similarityBoost != null)
          voiceSettings.similarity_boost = elevenLabsOptions.voiceSettings.similarityBoost;
        if (elevenLabsOptions.voiceSettings.style != null)
          voiceSettings.style = elevenLabsOptions.voiceSettings.style;
        if (elevenLabsOptions.voiceSettings.useSpeakerBoost != null)
          voiceSettings.use_speaker_boost = elevenLabsOptions.voiceSettings.useSpeakerBoost;
      }
      if (elevenLabsOptions.languageCode && !requestBody.language_code)
        requestBody.language_code = elevenLabsOptions.languageCode;
      if (elevenLabsOptions.pronunciationDictionaryLocators)
        requestBody.pronunciation_dictionary_locators = elevenLabsOptions.pronunciationDictionaryLocators.map((locator) => ({
          pronunciation_dictionary_id: locator.pronunciationDictionaryId,
          ...locator.versionId && { version_id: locator.versionId }
        }));
      if (elevenLabsOptions.seed != null)
        requestBody.seed = elevenLabsOptions.seed;
      if (elevenLabsOptions.previousText)
        requestBody.previous_text = elevenLabsOptions.previousText;
      if (elevenLabsOptions.nextText)
        requestBody.next_text = elevenLabsOptions.nextText;
      if (elevenLabsOptions.previousRequestIds)
        requestBody.previous_request_ids = elevenLabsOptions.previousRequestIds;
      if (elevenLabsOptions.nextRequestIds)
        requestBody.next_request_ids = elevenLabsOptions.nextRequestIds;
      if (elevenLabsOptions.applyTextNormalization)
        requestBody.apply_text_normalization = elevenLabsOptions.applyTextNormalization;
      if (elevenLabsOptions.applyLanguageTextNormalization != null)
        requestBody.apply_language_text_normalization = elevenLabsOptions.applyLanguageTextNormalization;
      if (elevenLabsOptions.enableLogging != null)
        queryParams.enable_logging = String(elevenLabsOptions.enableLogging);
    }
    if (Object.keys(voiceSettings).length > 0)
      requestBody.voice_settings = voiceSettings;
    if (instructions)
      warnings.push({
        type: "unsupported",
        feature: "instructions",
        details: `ElevenLabs speech models do not support instructions. Instructions parameter was ignored.`
      });
    return {
      path: `/v1/text-to-speech/${encodeURIComponent(voice)}`,
      withTimestamps: elevenLabsOptions?.withTimestamps === true,
      requestBody,
      queryParams,
      warnings
    };
  }
  getDialogueArgs({ text, voice, outputFormat = defaultOutputFormat, instructions, language, speed }, elevenLabsOptions, inputs, warnings) {
    if (!isDialogueModelId(this.modelId))
      throw new UnsupportedFunctionalityError({
        functionality: `dialogue with ${this.modelId}`,
        message: `ElevenLabs dialogue requires an eleven_v3 or eleven_v4 model; ${this.modelId} is not one.`
      });
    if (text.length > 0 && elevenLabsOptions.inputs != null)
      warnings.push({
        type: "other",
        message: "ElevenLabs dialogue uses providerOptions.elevenlabs.inputs; the text prompt was ignored."
      });
