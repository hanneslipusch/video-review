}
function addFormat2(schema, value, message, refs) {
  if (schema.format || schema.anyOf?.some((x) => x.format)) {
    if (!schema.anyOf)
      schema.anyOf = [];
    if (schema.format) {
      schema.anyOf.push({ format: schema.format });
      delete schema.format;
    }
    schema.anyOf.push({
