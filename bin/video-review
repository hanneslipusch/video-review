function elevenlabsErrorToMessage(data) {
  if (!("detail" in data))
    return data.error.message;
  const { detail } = data;
  if (typeof detail === "string")
    return detail;
  if (Array.isArray(detail))
    return detail.map((issue) => issue.loc != null && issue.loc.length > 0 ? `${issue.loc.join(".")}: ${issue.msg}` : issue.msg).join("; ");
  return detail.code != null ? `${detail.message} (${detail.code})` : detail.message;
}
