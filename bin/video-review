          path: `${path}${withTimestamps ? "/with-timestamps" : ""}`,
          modelId: this.modelId
        });
        const queryString = new URLSearchParams(queryParams).toString();
        return queryString ? `${baseUrl}?${queryString}` : baseUrl;
      })(),
      headers: combineHeaders(await resolve(this.config.headers), options.headers),
      body: requestBody,
      failedResponseHandler: elevenlabsFailedResponseHandler,
      successfulResponseHandler: path === "/v1/music/detailed" ? createMusicTimestampsResponseHandler() : withTimestamps ? createJsonResponseHandler(elevenLabsSpeechTimestampsResponseSchema) : createBinaryResponseHandler(),
      abortSignal: options.abortSignal,
      fetch: this.config.fetch
    });
    const envelope = !(value instanceof Uint8Array) && "audio_base64" in value ? value : undefined;
    const musicEnvelope = !(value instanceof Uint8Array) && "audio" in value ? value : undefined;
    return {
      audio: value instanceof Uint8Array ? value : ("audio" in value) ? value.audio : convertBase64ToUint8Array(value.audio_base64),
      warnings,
      request: { body: JSON.stringify(requestBody) },
      response: {
        timestamp: currentDate,
        modelId: this.modelId,
        headers: responseHeaders,
        body: rawResponse
      },
      providerMetadata: { elevenlabs: {
        ...queryParams.output_format != null && { outputFormat: queryParams.output_format },
        ...requestedDurationMs != null && { requestedDurationMs },
        ...musicEnvelope?.wordTimestamps != null && { wordTimestamps: musicEnvelope.wordTimestamps },
        ...envelope?.alignment != null && { alignment: toAlignmentMetadata(envelope.alignment) },
        ...envelope?.normalized_alignment != null && { normalizedAlignment: toAlignmentMetadata(envelope.normalized_alignment) },
        ...envelope?.voice_segments != null && { voiceSegments: envelope.voice_segments.map((segment) => ({
