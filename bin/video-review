// voiceover.ts
import { writeFile } from "fs/promises";
var tts = { model: "gemini-3.8-flash-tts", voice: "Kore" };
async function speak(text, path, key) {
  const response = await fetch("https://generativelanguage.googleapis.com/v1beta/interactions", {
    method: "POST",
    headers: { "x-goog-api-key": key, "Content-Type": "application/json" },
    signal: AbortSignal.timeout(120000),
    body: JSON.stringify({
      model: tts.model,
      input: [{ type: "user_input", content: [{
        type: "text",
        text,
        annotations: [{ type: "speech_metadata", style: "Speak like a colleague walking someone through a short demo: warm, clear and natural." }]
      }] }],
      response_format: { type: "audio", mime_type: "audio/wav" },
      generation_config: { speech_config: [{ voice: tts.voice }] }
    })
  });
  if (!response.ok) {
    const reason = /"message":\s*"([^"]+)"/.exec(await response.text())?.[1]?.trim().replace(/\.$/, "");
    throw new Error(`Gemini TTS returned HTTP ${response.status}${reason ? `: ${reason}` : ""}. Check GEMINI_API_KEY, model access and quota in Google AI Studio.`);
  }
  const result = await response.json();
  if (!result || typeof result !== "object" || !("steps" in result) || !Array.isArray(result.steps))
    throw new Error("Gemini TTS returned no output steps.");
  let audio;
  for (const step of result.steps) {
    if (!step || typeof step !== "object" || step.type !== "model_output" || !Array.isArray(step.content))
      continue;
    for (const block of step.content) {
      if (block && typeof block === "object" && block.type === "audio" && typeof block.data === "string")
        audio = block.data;
    }
  }
  if (!audio || !/^[A-Za-z0-9+/]+={0,2}$/.test(audio))
    throw new Error("Gemini TTS returned no valid base64 audio.");
  const wav = Buffer.from(audio, "base64");
  if (wav.toString("ascii", 0, 4) !== "RIFF" || wav.toString("ascii", 8, 12) !== "WAVE")
    throw new Error("Gemini TTS returned audio without the documented WAV header.");
  await writeFile(path, wav);
}

// cli.ts
import { parseArgs } from "util";

// contract.ts
var CHAPTER_LIMIT = 20;
var MIN_HOLD_SECONDS = 6;
var READING_SECONDS_PER_WORD = 0.9;
var SPEECH_TAIL_SECONDS = 1;
var STILL_SECONDS = 1 / 30;
var isImage = (path) => /\.(png|jpe?g)$/i.test(path);
function parseReview(value, duration) {
  if (!value || typeof value !== "object" || !("title" in value) || !("steps" in value))
    throw new Error("Expected {title, steps: [{start, end, chapter, text, source?}]}. See video-review build --help.");
  if (typeof value.title !== "string" || !value.title.trim() || value.title.length > 160)
    throw new Error("title must contain 1\u2013160 characters.");
  const notes = "notes" in value ? value.notes : "";
  if (typeof notes !== "string" || notes.length > 4000)
    throw new Error("notes must be Markdown of at most 4000 characters.");
  if (!Array.isArray(value.steps) || !value.steps.length)
    throw new Error("steps must be a nonempty array.");
  let previousEnd = 0;
  const steps = value.steps.map((step, index) => {
    if (!step || typeof step !== "object" || !("chapter" in step) || !("text" in step))
      throw new Error(`Step ${index + 1} needs chapter and text.`);
    const { chapter, text } = step;
    const source = "source" in step ? step.source : undefined;
    if (source !== undefined && (typeof source !== "string" || !source.trim() || /[\u0000-\u001f]/.test(source)))
      throw new Error(`Step ${index + 1}: source must be a nonempty local file path.`);
    const image = source !== undefined && isImage(source);
    if (image && (("start" in step) || ("end" in step)))
      throw new Error(`Step ${index + 1}: an image step takes no start or end; its hold follows the caption.`);
    if (!image && (!("start" in step) || !("end" in step)))
      throw new Error(`Step ${index + 1} needs start and end.`);
    const start = image ? 0 : ("start" in step) ? step.start : undefined;
    const end = image ? STILL_SECONDS : ("end" in step) ? step.end : undefined;
    if (typeof start !== "number" || typeof end !== "number" || !Number.isFinite(start) || !Number.isFinite(end) || start < (source === undefined ? previousEnd : 0) || end <= start || end >= 86400 || source === undefined && end > duration)
      throw new Error(source === undefined ? `Step ${index + 1}: intervals must be ordered, nonoverlapping, and inside 0\u2013${duration.toFixed(3)} seconds.` : `Step ${index + 1}: intervals need finite 0 <= start < end < 86400; end must fit the source.`);
    if (typeof text !== "string" || !text.trim() || text.length > 320 || /[\r\n\u0000-\u001f]|-->/.test(text))
      throw new Error(`Step ${index + 1}: text must be one line of 1\u2013320 characters without VTT delimiters.`);
    if (typeof chapter !== "string" || !chapter.trim() || chapter.length > CHAPTER_LIMIT || /[\r\n\u0000-\u001f]|-->/.test(chapter))
      throw new Error(`Step ${index + 1}: chapter must be one line of 1\u2013${CHAPTER_LIMIT} characters without VTT delimiters.`);
    if (source === undefined)
      previousEnd = end;
    return { start, end, chapter: chapter.trim(), text: text.trim(), ...source === undefined ? {} : { source } };
  });
  return { title: value.title.trim(), notes: notes.trim(), steps };
}
function pace(steps, speech) {
  let at = 0;
  return steps.map((step, index) => {
    const speechSeconds = speech[index];
    if (speechSeconds === undefined || !Number.isFinite(speechSeconds) || speechSeconds < 0)
      throw new Error(`Missing speech duration for step ${index + 1}.`);
    const action = Math.ceil((step.end - step.start) * 30) / 30;
    const read = speechSeconds > 0 ? speechSeconds + SPEECH_TAIL_SECONDS : step.text.split(/\s+/).length * READING_SECONDS_PER_WORD;
    const hold = Math.ceil(Math.max(MIN_HOLD_SECONDS, read) * 30) / 30;
    const chapter = { ...step, at, outcome: at + action, until: at + action + hold, speechSeconds };
    at = chapter.until;
    return chapter;
  });
}
function vttTime(seconds) {
  const milliseconds = Math.round(seconds * 1000);
  const parts = [Math.floor(milliseconds / 3600000), Math.floor(milliseconds / 60000) % 60, Math.floor(milliseconds / 1000) % 60];
  return parts.map((value) => String(value).padStart(2, "0")).join(":") + "." + String(milliseconds % 1000).padStart(3, "0");
}
function vtt(cues) {
  return `WEBVTT

${cues.map(({ start, end, text, id }) => `${id === undefined ? "" : `${id}
`}${vttTime(start)} --> ${vttTime(end)}
${text}
`).join(`
`)}`;
}
function chaptersVtt(chapters) {
  const edge = (seconds) => Math.ceil(seconds * 1000 - 0.000001) / 1000;
  return vtt(chapters.map((s, i) => ({ id: i + 1, start: edge(s.at), end: edge(s.until), text: s.chapter })));
}
function renderPlayer(template, title, notes, aspect, voiceover) {
  const html = Bun.markdown.html(notes, { noHtmlBlocks: true, noHtmlSpans: true, autolinks: true });
  const VOICEOVER = voiceover ? '<track kind="metadata" label="voiceover" src="voiceover.vtt" default>' : "";
  const VIDEO = voiceover ? "player.mp4" : "video.mp4";
  const tokens = { TITLE: Bun.escapeHTML(title), NOTES: html, ASPECT: aspect, VOICEOVER, VIDEO };
  return template.replace(/\{\{(TITLE|NOTES|ASPECT|VOICEOVER|VIDEO)\}\}/g, (_, token) => tokens[token]);
}

// cli.ts
var FRAME_STEP = 0.5;
var help = `video-review \u2014 turn an existing recording into a captioned review

  video-review build <video> <steps.json> --out <directory>
  video-review build --help
  video-review frames <video> --out <directory>

Example:
  video-review frames recording.webm --out frames
  video-review build recording.webm steps.json --out review

frames writes one image every ${FRAME_STEP} s of the recording, named by its second (0003.5.jpg),
and sheet-1.jpg, sheet-2.jpg\u2026 with 12 labelled frames each, to find the steps at a glance.
Sheets are too small for text: open the full frame at each step's end before writing its caption.

The recorder, verification, hosting and sharing belong to your workflow.`;
var buildHelp = `${help}

Input: {"title":"Saved settings","notes":"PR: https://example.com/pull/7","steps":[{"start":0,"end":3,"chapter":"Saved value","text":"The saved value appeared."}]}
notes is optional Markdown shown under the title: links to the PR, issue, environment or logs, and what you did not check.
chapter is a short label of 1\u2013${CHAPTER_LIMIT} characters; text is the caption and, with --voiceover, the spoken line.
Optional source names another video or a PNG/JPG card, relative to steps.json. Steps without it use <video>
and stay ordered; other videos use their own clock and may repeat or reorder. An image step has no start or end:
{"source":"what-changed.png","chapter":"What changed","text":"Watch the attachment when the model switches."}
Every source fits the main video's frame with letterboxing.
Seconds refer to the source media clock. Each end must show the observed result.
Only listed intervals are included, at original speed, followed by a hold for the observation.

--out <directory>  Required; replaces a review built here before, refuses any other folder.
--voiceover        Add a voiceover. Use it when the reviewer will listen rather than read, such as
                   a demo for people outside the work; skip it for routine evidence.
--help             Show the input contract and example before recording.

--voiceover needs GEMINI_API_KEY from https://aistudio.google.com/apikey for direct Gemini TTS.
Outputs: index.html, video.mp4, captions.vtt, chapters.vtt, thumbnails.vtt, thumbnails.jpg, timeline.json, frames/*.jpg;
--voiceover adds speech to video.mp4, and voiceover.vtt, speech/*.m4a and a silent player.mp4 for the page,
which speaks each step during its hold, sped up less than the video.
Source audio is removed. Only --voiceover adds audio. Inputs are never changed.
Success prints one JSON object listing one result frame per step. Read each; if a caption is wrong, fix steps.json and build again.
Exit 0: built, 1: runtime failure, 2: usage.`;
function requireFFmpeg() {
  for (const tool of ["ffmpeg", "ffprobe"])
    if (!Bun.which(tool))
      throw new Error(`${tool} not found on PATH. Install FFmpeg: https://ffmpeg.org/download.html`);
}
async function run(command) {
  return await new Promise((resolve, reject) => {
    const child = spawn(command[0], command.slice(1), { stdio: ["ignore", "pipe", "pipe"] });
    const stdout = [], stderr = [];
    child.stdout.on("data", (chunk) => stdout.push(chunk));
    child.stderr.on("data", (chunk) => stderr.push(chunk));
    child.on("error", reject);
    child.on("close", (code) => {
      if (code !== 0)
        reject(new Error(`${command[0]} failed (${code}): ${Buffer.concat(stderr).toString().trim()}`));
      else
        resolve(Buffer.concat(stdout).toString());
    });
  });
}
async function probe(path, video = false) {
  const data = JSON.parse(await run(["ffprobe", "-v", "error", ...video ? ["-select_streams", "v:0", "-show_entries", "stream=width,height:format=duration"] : ["-show_entries", "format=duration"], "-of", "json", path]));
  const { width = 0, height = 0 } = data.streams?.[0] ?? {};
  if (video && !width)
    throw new Error("Input contains no video stream.");
  const seconds = Number(data.format?.duration);
  if (!Number.isFinite(seconds) || seconds <= 0 || seconds >= 86400)
    throw new Error(`Cannot read a positive media duration below 24 hours: ${basename(path)}`);
  return { seconds, width, height };
}
async function sha256(path) {
  const hasher = createHash("sha256");
  for await (const chunk of createReadStream(path))
    hasher.update(chunk);
  return hasher.digest("hex");
}
async function build(video, input, destination, voiceover) {
  requireFFmpeg();
  const source = await realpath(video);
  const target = resolve(destination);
  const main = await probe(source, true);
  const review = parseReview(JSON.parse(await readFile(input, "utf8")), main.seconds);
  const media = new Map;
  const stepSources = [];
  for (const [index, step] of review.steps.entries()) {
    const path = step.source === undefined ? source : await realpath(resolve(dirname(resolve(input)), step.source));
    if (!media.has(path)) {
      const image = isImage(path);
      if (image) {
        const data = JSON.parse(await run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=codec_name,width,height", "-of", "json", path]));
        const stream = data.streams?.[0];
        if (!stream?.width || !["png", "mjpeg"].includes(stream.codec_name))
          throw new Error(`Invalid PNG/JPG image: ${basename(path)}`);
      }
      media.set(path, { path, image, seconds: image ? Infinity : (path === source ? main : await probe(path, true)).seconds, sha256: await sha256(path) });
    }
    if (step.end > media.get(path).seconds)
      throw new Error(`Step ${index + 1}: end exceeds ${basename(path)} duration.`);
    stepSources.push(path);
  }
  await run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i", "color=s=2x2:d=0.04", "-c:v", "libx264", "-f", "null", "-"]);
  const key = process.env.GEMINI_API_KEY;
  if (voiceover && !key)
    throw new Error("Set GEMINI_API_KEY from https://aistudio.google.com/apikey, or build without --voiceover for a captions-only review.");
  const existing = await readdir(target).catch(() => null);
  if (existing?.length && !existing.includes("timeline.json"))
    throw new Error(`${target} exists and is not a video-review output. Choose another --out directory.`);
  const output = `${target}.partial-${process.pid}`;
  await mkdir(dirname(target), { recursive: true });
  await mkdir(output);
  let complete = false;
  try {
    await mkdir(join(output, "frames"));
    if (voiceover)
      await mkdir(join(output, "speech"));
    const lengths = [];
    for (const [index, step] of review.steps.entries()) {
      if (!voiceover) {
        lengths.push(0);
        continue;
      }
      process.stderr.write(`Voiceover ${index + 1}/${review.steps.length}
`);
      await speak(step.text, join(output, `speech-${index}.wav`), key);
      lengths.push((await probe(join(output, `speech-${index}.wav`))).seconds);
    }
    const timeline = pace(review.steps, lengths);
    const total = timeline.at(-1).until;
    const videoPath = join(output, "video.mp4");
    const sources = [...media.values()];
    const args = ["ffmpeg", "-v", "error"];
    for (const media of sources)
      args.push(...media.image ? ["-loop", "1", "-framerate", "30"] : [], "-reinit_filter:v", "0", "-i", media.path);
    if (voiceover)
      for (const [index] of timeline.entries())
        args.push("-i", join(output, `speech-${index}.wav`));
    const width = 2 * Math.ceil(main.width / 2), height = 2 * Math.ceil(main.height / 2);
    const filters = [];
    for (const [inputIndex, media] of sources.entries()) {
      const indices = stepSources.flatMap((path, i) => path === media.path ? [i] : []);
      filters.push(`[${inputIndex}:v]split=${indices.length}${indices.map((i) => `[source${i}]`).join("")}`);
    }
    for (const [index, step] of timeline.entries()) {
      const action = step.outcome - step.at, total = step.until - step.at;
      filters.push(`[source${index}]trim=start=${step.start}:end=${step.end},setpts=PTS-STARTPTS,fps=30,scale=${width}:${height}:force_original_aspect_ratio=decrease,pad=${width}:${height}:(ow-iw)/2:(oh-ih)/2,setsar=1,tpad=stop_mode=clone:stop_duration=${total},trim=duration=${total},setpts=PTS-STARTPTS[v${index}]`);
      if (voiceover)
        filters.push(`[${sources.length + index}:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=mono,adelay=${Math.round(action * 1000)}:all=1,apad,atrim=duration=${total},asetpts=PTS-STARTPTS[a${index}]`);
    }
    filters.push(`${timeline.map((_, i) => `[v${i}]${voiceover ? `[a${i}]` : ""}`).join("")}concat=n=${timeline.length}:v=1:a=${voiceover ? 1 : 0}[v]${voiceover ? "[a]" : ""}`);
    await run([...args, "-filter_complex_threads", "2", "-filter_complex", filters.join(";"), "-map", "[v]", ...voiceover ? ["-map", "[a]"] : ["-an"], "-c:v", "libx264", "-threads", "2", "-preset", "fast", "-crf", "24", "-pix_fmt", "yuv420p", ...voiceover ? ["-c:a", "aac", "-b:a", "96k"] : [], "-movflags", "+faststart", videoPath]);
    const rendered = await probe(videoPath, true);
    if (voiceover)
      await run(["ffmpeg", "-v", "error", "-i", videoPath, "-map", "0:v", "-c", "copy", "-movflags", "+faststart", join(output, "player.mp4")]);
    if (Math.abs(rendered.seconds - total) > 0.1)
      throw new Error(`Rendered duration ${rendered.seconds.toFixed(3)}s differs from the planned ${total.toFixed(3)}s. The recording may change frame properties midstream.`);
    for (const [index, step] of timeline.entries()) {
      await run(["ffmpeg", "-v", "error", "-ss", String(step.outcome + 0.1), "-i", videoPath, "-frames:v", "1", "-pix_fmt", "yuvj420p", "-threads", "1", "-q:v", "2", join(output, "frames", `${index + 1}.jpg`)]);
      if (!(await stat(join(output, "frames", `${index + 1}.jpg`))).size)
        throw new Error(`Outcome frame ${index + 1} is empty.`);
      if (!voiceover)
        continue;
      await run(["ffmpeg", "-v", "error", "-i", join(output, `speech-${index}.wav`), "-c:a", "aac", "-b:a", "64k", "-movflags", "+faststart", join(output, "speech", `${index + 1}.m4a`)]);
      await rm(join(output, `speech-${index}.wav`));
    }
    await writeFile2(join(output, "captions.vtt"), vtt(timeline.map((s, i) => ({ id: i + 1, start: s.outcome, end: s.until, text: s.text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;") }))));
    await writeFile2(join(output, "chapters.vtt"), chaptersVtt(timeline));
    if (voiceover)
      await writeFile2(join(output, "voiceover.vtt"), vtt(timeline.map((s, i) => ({ id: i + 1, start: s.outcome, end: s.until, text: `speech/${i + 1}.m4a` }))));
    const count = Math.ceil(total / 2), columns = Math.min(10, count), rows = Math.ceil(count / columns);
    const tileHeight = 2 * Math.round(160 * rendered.height / rendered.width);
    await run([
      "ffmpeg",
      "-v",
      "error",
      "-i",
      videoPath,
      "-vf",
      `fps=1/2:start_time=0:round=up,scale=320:${tileHeight},tile=${columns}x${rows}`,
      "-frames:v",
      "1",
      "-pix_fmt",
      "yuvj420p",
      "-threads",
      "1",
      "-q:v",
      "2",
      join(output, "thumbnails.jpg")
    ]);
    if (!(await stat(join(output, "thumbnails.jpg"))).size)
      throw new Error("Thumbnail sprite is empty.");
    await writeFile2(join(output, "thumbnails.vtt"), vtt(Array.from({ length: count }, (_, i) => ({
      start: i * 2,
      end: Math.min(total, (i + 1) * 2),
      text: `thumbnails.jpg#xywh=${i % columns * 320},${Math.floor(i / columns) * tileHeight},320,${tileHeight}`
    }))));
    const manifest = { title: review.title, notes: review.notes, sources: sources.map(({ path, sha256 }) => ({ file: basename(path), sha256 })), voiceover: voiceover ? tts : null, steps: timeline };
    await writeFile2(join(output, "timeline.json"), JSON.stringify(manifest, null, 2) + `
`);
    await mkdir(join(output, "vendor"));
    for (const [name, content] of Object.entries(assets))
      await writeFile2(join(output, "vendor", name), Buffer.from(content, "base64"));
    await writeFile2(join(output, "index.html"), renderPlayer(template, review.title, review.notes, `${rendered.width}/${rendered.height}`, voiceover));
    await rm(target, { recursive: true, force: true });
    await rename(output, target);
    complete = true;
    console.log(JSON.stringify({ player: join(target, "index.html"), video: join(target, "video.mp4"), timeline: join(target, "timeline.json"), frames: timeline.map((_, i) => join(target, "frames", `${i + 1}.jpg`)) }));
  } finally {
    if (!complete)
      await rm(output, { recursive: true, force: true });
  }
}
async function frames(video, destination) {
  requireFFmpeg();
  const output = resolve(destination);
  const { seconds } = await probe(await realpath(video), true);
  await mkdir(output, { recursive: true });
  const sample = `fps=${1 / FRAME_STEP}:start_time=0,trim=end_frame=${Math.floor(seconds / FRAME_STEP) + 1}`;
  await run(["ffmpeg", "-v", "error", "-y", "-reinit_filter:v", "0", "-i", video, "-vf", `${sample},scale=640:-2`, "-pix_fmt", "yuvj420p", "-q:v", "3", join(output, "frame-%d.jpg")]);
  await run([
    "ffmpeg",
    "-v",
    "error",
    "-y",
    "-reinit_filter:v",
    "0",
    "-i",
    video,
    "-vf",
    `${sample},scale=480:-2,` + "pad=iw:ih+22:0:0:white,drawtext=text='%{pts\\:hms}':fontsize=18:x=4:y=h-20:fontcolor=black,tile=3x4:padding=4:color=white",
    "-pix_fmt",
    "yuvj420p",
    "-q:v",
    "3",
    join(output, "sheet-%d.jpg")
  ]);
  const files = await readdir(output);
  const written = files.filter((name) => /^frame-\d+\.jpg$/.test(name));
  for (const name of written) {
    const at = (Number(name.slice(6, -4)) - 1) * FRAME_STEP;
    await rename(join(output, name), join(output, `${at.toFixed(1).padStart(6, "0")}.jpg`));
  }
  const sheets = files.filter((name) => /^sheet-\d+\.jpg$/.test(name)).sort((a, b) => Number(a.slice(6, -4)) - Number(b.slice(6, -4)));
  console.log(JSON.stringify({ frames: output, count: written.length, every: FRAME_STEP, seconds, sheets: sheets.map((name) => join(output, name)) }));
}
try {
  const { values, positionals } = parseArgs({ args: process.argv.slice(2), options: { out: { type: "string" }, help: { type: "boolean" }, voiceover: { type: "boolean" } }, allowPositionals: true, strict: true });
  const [command, video, input, ...extra] = positionals;
  if (values.help || !command) {
    console.log(command === "build" ? buildHelp : help);
  } else if (command === "build" && video && input && values.out && !extra.length) {
    await build(video, input, values.out, values.voiceover === true);
  } else if (command === "frames" && video && !input && values.out && !values.voiceover) {
    await frames(video, values.out);
  } else {
    console.error(help);
    process.exitCode = 2;
  }
} catch (error) {
  let message = error instanceof Error ? error.message : "Build failed.";
  const key = process.env.GEMINI_API_KEY;
  if (key)
    message = message.replaceAll(key, "[redacted]");
  console.error(`video-review: ${message}`);
  process.exitCode = error instanceof Error && "code" in error && String(error.code).startsWith("ERR_PARSE_ARGS") ? 2 : 1;
}
