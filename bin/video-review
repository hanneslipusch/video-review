var googleEmbeddingModelOptions = lazySchema(() => zodSchema(object({
  outputDimensionality: number2().optional(),
  taskType: _enum([
    "SEMANTIC_SIMILARITY",
    "CLASSIFICATION",
    "CLUSTERING",
    "RETRIEVAL_DOCUMENT",
