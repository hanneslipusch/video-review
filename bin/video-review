      path: isMusic ? elevenLabsOptions?.withTimestamps === true ? "/v1/music/detailed" : "/v1/music" : "/v1/sound-generation",
      requestBody,
      queryParams,
      requestedDurationMs,
      warnings,
      withTimestamps: false
    };
  }
  async doGenerate(options) {
    const currentDate = this.config._internal?.currentDate?.() ?? /* @__PURE__ */ new Date;
    const { path, requestBody, queryParams, requestedDurationMs, warnings, withTimestamps } = isMusicModelId(this.modelId) || isSoundEffectsModelId(this.modelId) ? await this.getAudioGenerationArgs(options) : {
      ...await this.getArgs(options),
